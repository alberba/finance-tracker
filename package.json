{
  "name": "finance-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:types": "wrangler types",
    "d1:export": "node scripts/export-sqlite-to-d1.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply finance-tracker-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply finance-tracker-db --remote",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^12.6.12",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^3.0.0",
    "astro": "^5.18.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.4.1",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^10.4.1",
    "wrangler": "^4.67.0"
  },
  "dependencies": {
    "@astrojs/vue": "^5.1.4",
    "@tailwindcss/vite": "^4.2.2",
    "chart.js": "4.4.7",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.35",
    "zod": "^4.3.6"
  }
}
