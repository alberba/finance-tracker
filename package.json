{
  "name": "finance-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "cf:types": "wrangler types",
    "d1:migrate:local:v2": "wrangler d1 migrations apply finance-tracker-db-v2 --local --persist-to .wrangler/state",
    "db:repair": "tsx scripts/repair-corrupted-data.ts",
    "setup:worktree": "bash scripts/setup-worktree.sh",
    "dev": "astro dev",
    "build": "astro build",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "gate": "pnpm check:deps && pnpm lint && pnpm check && pnpm test",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:component": "vitest run --project component",
    "test:component:watch": "vitest --project component",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:shuffle": "playwright test --grep-invert @visual --shuffle",
    "test:e2e:cross-browser": "playwright test --grep @smoke --project=firefox --project=webkit",
    "test:e2e:webmcp": "playwright test tests/e2e/webmcp.spec.ts --project=chromium",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:visual:linux": "bash scripts/e2e-visual-linux.sh",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:sync-v2": "playwright test --config playwright.sync-v2.config.ts",
    "test:e2e:bitvavo": "playwright test --config playwright.bitvavo.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:all": "playwright install chromium firefox webkit",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:e2e:shard": "tsx scripts/e2e-functional-shard.ts",
    "check:deps": "node scripts/check-installed-dependencies.mjs",
    "local:setup": "node scripts/setup-local.mjs",
    "local:up": "node scripts/local-compose.mjs up",
    "local:down": "node scripts/local-compose.mjs down",
    "local:archive": "node scripts/archive-local.mjs",
    "local:archive:install": "node scripts/install-orca-archive.mjs",
    "local:up:prod": "node scripts/local-compose.mjs up production"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/cloudflare": "^14.3.4",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "astro": "^7.3.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tailwind-csstree": "^0.4.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.4",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/vue": "^7.1.1",
    "@better-auth/passkey": "1.7.12",
    "@better-auth/utils": "0.5.0",
    "@sentry/astro": "^11.8.0",
    "@sentry/browser": "11.8.0",
    "@sentry/cloudflare": "^11.8.0",
    "@sentry/node": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "1.7.12",
    "better-sqlite3": "^13.0.3",
    "chart.js": "4.5.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "effect": "4.0.5",
    "jose": "^6.2.13",
    "pinia": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "resend": "6.34.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "yahoo-finance2": "^4.0.5",
    "zod": "^4.6.7"
  }
}
