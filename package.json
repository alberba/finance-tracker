{
  "name": "finance-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "cf:types": "wrangler types",
    "d1:migrate:local:v2": "wrangler d1 migrations apply finance-tracker-db-v2 --local --persist-to .wrangler/state",
    "db:repair": "tsx scripts/repair-corrupted-data.ts",
    "db:repair-links": "tsx scripts/repair-instrument-links.ts",
    "db:merge-accounts": "tsx scripts/merge-accounts-into-instruments.ts",
    "reports:backfill": "tsx scripts/reports-backfill.ts",
    "setup:worktree": "bash scripts/setup-worktree.sh",
    "dev": "astro dev",
    "dev:worktree": "node scripts/dev-worktree.mjs",
    "dev:account": "node scripts/dev-account.mjs",
    "build": "astro build",
    "audit:prod": "bun scripts/audit-prod.mjs",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "benchmark:pages": "node scripts/benchmark-pages.mjs",
    "preview": "astro preview",
    "check": "astro check && vue-tsc --noEmit",
    "check:vue": "vue-tsc --noEmit",
    "lint": "eslint .",
    "gate": "bun run check:deps && bun run lint && bun run check && bun run test",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:all": "node scripts/test-all.mjs",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:component": "vitest run --project component",
    "test:component:watch": "vitest --project component",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:shuffle": "playwright test --shuffle",
    "test:e2e:cross-browser": "playwright test --grep @smoke --project=firefox --project=webkit",
    "test:e2e:webmcp": "playwright test tests/e2e/webmcp.spec.ts --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:sync-v2": "playwright test --config playwright.sync-v2.config.ts",
    "test:e2e:bitvavo": "playwright test --config playwright.bitvavo.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:all": "playwright install chromium firefox webkit",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:e2e:shard": "tsx scripts/e2e-functional-shard.ts",
    "check:deps": "node scripts/check-installed-dependencies.mjs",
    "local:setup": "node scripts/setup-local.mjs",
    "local:up": "node scripts/local-compose.mjs up",
    "local:down": "node scripts/local-compose.mjs down",
    "local:archive": "node scripts/archive-local.mjs",
    "local:archive:install": "node scripts/install-orca-archive.mjs",
    "local:up:prod": "node scripts/local-compose.mjs up production",
    "postinstall": "node scripts/check-installed-dependencies.mjs --record"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.3.4",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "0.3.3",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "astro": "^7.3.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "tailwind-csstree": "^0.4.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.6",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.3.14",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@astrojs/vue": "7.1.2",
    "@better-auth/passkey": "1.7.18",
    "@better-auth/utils": "0.5.1",
    "@sentry/astro": "^11.12.0",
    "@sentry/browser": "11.12.0",
    "@sentry/cloudflare": "^11.12.0",
    "@sentry/node": "^11.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "better-auth": "1.7.18",
    "better-sqlite3": "^13.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "effect": "4.1.4",
    "jose": "^6.2.17",
    "pdfmake": "0.3.14",
    "pinia": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "resend": "6.38.1",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "yahoo-finance2": "^4.0.6",
    "zod": "^4.6.7"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "devalue": "5.9.3",
    "undici@7": "7.30.1",
    "undici@8": "8.12.2",
    "nanoid": "3.3.18",
    "picomatch": "2.3.2",
    "postcss": "8.5.26",
    "rollup": "4.59.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2",
    "yaml": "2.8.3",
    "esbuild@0.18.20": "0.25.12",
    "fast-uri": "3.1.8",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "^2.11.0",
    "js-yaml": "4.3.2",
    "svgo": "4.1.0"
  },
  "patchedDependencies": {
    "@cloudflare/vite-plugin@1.63.1": "patches/@cloudflare__vite-plugin@1.63.1.patch",
    "http-cache-semantics@4.2.0": "patches/http-cache-semantics@4.2.0.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}
