{
  "name": "finance-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:types": "wrangler types",
    "d1:export": "node scripts/export-sqlite-to-d1.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply finance-tracker-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply finance-tracker-db --remote",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^12.6.12",
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "astro": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.67.0"
  },
  "dependencies": {
    "claude": "^0.1.2"
  }
}
