{
  "name": "finance-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "cf:types": "wrangler types",
    "d1:export": "node scripts/export-sqlite-to-d1.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply finance-tracker-db --local --persist-to .wrangler/state",
    "d1:migrate:remote": "wrangler d1 migrations apply finance-tracker-db --remote",
    "d1:migrate:local:v2": "wrangler d1 migrations apply finance-tracker-db-v2 --local --persist-to .wrangler/state",
    "d1:migrate:remote:v2": "wrangler d1 migrations apply finance-tracker-db-v2 --remote",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "migrate:v1-to-v2": "tsx scripts/migrate-v1-to-v2.ts",
    "migrate:export-v1-json": "tsx scripts/export-v2-to-v1-json.ts",
    "migrate:validate-parity": "tsx scripts/validate-migration-parity.ts",
    "dev": "astro dev",
    "build": "astro build",
    "deploy:cf": "wrangler deploy --config dist/server/wrangler.json",
    "versions:cf": "wrangler versions upload --config dist/server/wrangler.json",
    "deploy:worker": "pnpm build && pnpm deploy:cf",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:component": "vitest run --project component",
    "test:component:watch": "vitest --project component",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:sync-v2": "playwright test --config playwright.sync-v2.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.2.3",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "astro": "^7.2.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwind-csstree": "^0.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.2",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.2",
    "@sentry/astro": "^10.70.0",
    "@sentry/browser": "10.72.0",
    "@sentry/cloudflare": "^10.72.0",
    "@tailwindcss/vite": "^4.3.3",
    "chart.js": "4.5.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "pinia": "^4.0.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "zod": "^4.5.2"
  }
}
