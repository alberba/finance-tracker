{
  "name": "finance-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:types": "wrangler types",
    "d1:export": "node scripts/export-sqlite-to-d1.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply finance-tracker-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply finance-tracker-db --remote",
    "d1:migrate:local:v2": "wrangler d1 migrations apply finance-tracker-db-v2 --local",
    "d1:migrate:remote:v2": "wrangler d1 migrations apply finance-tracker-db-v2 --remote",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "migrate:v1-to-v2": "tsx scripts/migrate-v1-to-v2.ts",
    "migrate:export-v1-json": "tsx scripts/export-v2-to-v1-json.ts",
    "migrate:validate-parity": "tsx scripts/validate-migration-parity.ts",
    "dev": "astro dev",
    "build": "astro build",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:sync-v2": "playwright test --config playwright.sync-v2.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^12.6.12",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^3.0.0",
    "astro": "^5.18.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "tailwind-csstree": "^0.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.4.1",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^10.4.1",
    "wrangler": "^4.67.0"
  },
  "dependencies": {
    "@astrojs/vue": "^5.1.4",
    "@sentry/browser": "10.66.0",
    "@sentry/astro": "^10.66.0",
    "@sentry/cloudflare": "^10.66.0",
    "@tailwindcss/vite": "^4.2.2",
    "chart.js": "4.4.7",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "pinia": "^3.0.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.35",
    "zod": "^4.3.6"
  }
}
