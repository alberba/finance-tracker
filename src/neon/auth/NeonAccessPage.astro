---
import NeonFontPreloads from '../layout/NeonFontPreloads.astro'
import NeonAccessForm from './NeonAccessForm.vue'

/**
 * `/login` in the new design: the brand, one card with the access form and the
 * way into the demo. There is no frame (no session yet); the column is centred
 * and the card loses its box when the column is under 480px, where it would only eat
 * margin (DESIGN.md, Tarjeta: padding 16px 12px on mobile). `/login` mounts it
 * when the design cookie asks for the new design (ADR 0010).
 */
export interface Props {
  invitationError: string
  googleEnabled: boolean
  githubEnabled: boolean
  verifyEmail?: string
  initialError?: string
}

const props = Astro.props
---

<!-- The doctype comes from /login, the page that mounts this document. -->
<html lang="es" data-ui="neon">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Theme before the first paint, the rule of the shell
      // (FinanceTrackerShell.astro): a stored theme name wins, otherwise
      // «oscuro suave», or «claro melocotón» if the system asks for light.
      ;(function () {
        const root = document.documentElement
        try {
          const prefersDark =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
          // Blocked storage still honours the system.
          let stored = null
          try {
            stored = localStorage.getItem('neon-theme')
          } catch {
            /* Storage blocked: no stored choice. */
          }
          root.dataset.theme = [
            'oscuro-suave',
            'oscuro-fuerte',
            'claro-hueso',
            'claro-melocoton',
          ].includes(stored)
            ? stored
            : prefersDark
              ? 'oscuro-suave'
              : 'claro-melocoton'
        } catch {
          root.dataset.theme = 'oscuro-suave'
        }
      })()
    </script>
    <meta name="theme-color" content="#1B1A18" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F7EBE2" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <NeonFontPreloads />
    <title>Acceso · Finanzas</title>
  </head>
  <body>
    <main class="@container mx-auto grid min-h-dvh w-full max-w-[520px] content-center gap-6 px-4 py-10">
      <p
        class="font-display text-brand text-text motion-safe:animate-rise text-center leading-none font-extrabold tracking-brand"
        aria-label="finanzas"
      >
        finanzas
        <span class="text-accent-text" aria-hidden="true">
          .
        </span>
      </p>
      <section
        class="@[480px]:border-line @[480px]:bg-panel @[480px]:rounded-card @[480px]:border @[480px]:px-8 @[480px]:py-8 motion-safe:animate-rise px-1 [animation-delay:70ms]"
        aria-labelledby="access-heading"
      >
        <NeonAccessForm client:load {...props} />
      </section>
      <footer class="motion-safe:animate-rise text-center [animation-delay:140ms]">
        <a
          href="/?demo=true"
          class="rounded-pill text-soft pointer-fine:hover:text-text outline-accent inline-flex min-h-11 items-center px-4 text-[14px] font-extrabold underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          Explorar la demo ↗
        </a>
      </footer>
    </main>
  </body>
</html>
