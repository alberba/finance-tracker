---
import { APP_SECTIONS } from '../../config/app-sections'
import type { SectionId } from '../../scripts/types'
import { BAR_SECTION_IDS } from './mobile-sections'
import NavIcon from './NavIcon.astro'

/**
 * Bottom bar of the mobile frame (DESIGN.md, «Barra inferior móvil»): three
 * sections and «Más», as icons in a floating capsule that leaves room for the FAB beside it. `data-primary-sections` tells the
 * shell's navigation script which sections the bar already shows, so «Más»
 * lights up for every other one. «Más» carries a dot while a report has news
 * the person has not read (artboard «hoja «Más» con novedades · móvil»):
 * src/scripts/app/reports-badge.ts shows `[data-reports-badge-dot]` and writes
 * the sentence the button is described by into `[data-reports-count-spoken]`.
 *
 * The active item's pill is one shared mark, `[data-nav-indicator]`, that
 * slides to the item the navigation script marks (`aria-current`, or
 * `data-active` on «Más»): the bar reads its slot with `:has()` into `--nav-i`.
 * With no item marked (/reportes) it fades out.
 */
export interface Props {
  activeSection: SectionId | null
}

const { activeSection } = Astro.props
const sections = BAR_SECTION_IDS.map((id) => APP_SECTIONS.find((section) => section.id === id)!)
const moreIsActive = activeSection !== null && !BAR_SECTION_IDS.includes(activeSection)

const ITEM =
  'group relative z-10 text-muted aria-[current=page]:text-text data-[active=true]:text-text outline-accent flex min-h-12 min-w-0 flex-1 items-center justify-center rounded-full focus-visible:outline-2 focus-visible:-outline-offset-2 motion-safe:transition-[color,scale] motion-safe:duration-[140ms,140ms] motion-safe:ease-out motion-safe:active:scale-[0.97]'
const PILL = 'grid h-10 w-13 place-items-center rounded-pill'
// The slot of the marked item, 0 to 3, for the indicator (written out: Tailwind
// only finds whole class names).
const SLOTS =
  '[&:has(>:nth-child(2):is([aria-current=page],[data-active=true]))]:[--nav-i:1] [&:has(>:nth-child(3):is([aria-current=page],[data-active=true]))]:[--nav-i:2] [&:has(>:nth-child(4):is([aria-current=page],[data-active=true]))]:[--nav-i:3]'
---

<nav
  class:list={[
    'group/nav bg-panel border-line frame:hidden fixed inset-s-3 inset-e-3 inset-be-[calc(16px+env(safe-area-inset-bottom,0px))] z-30 flex h-16 items-center rounded-full border px-1.5 shadow-[0_10px_24px_oklch(0%_0_none/0.35)] [:root:has([data-fab-apuntar]):not(:has([data-bottom-dock]))_&]:inset-e-[84px]',
    SLOTS,
  ]}
  aria-label="Navegación principal"
>
  {sections.map((section) => (
    <button
      type="button"
      class={ITEM}
      data-nav-item
      data-section={section.id}
      aria-controls={section.id}
      aria-current={section.id === activeSection ? 'page' : undefined}
    >
      <span class={PILL}>
        <span class="size-5.5 [&>svg]:size-full">
          <NavIcon sectionId={section.id} />
        </span>
      </span>
      <span class="sr-only">{section.label}</span>
    </button>
  ))}
  <button
    type="button"
    class={ITEM}
    data-mobile-more-trigger
    data-primary-sections={BAR_SECTION_IDS.join(',')}
    data-active={moreIsActive ? 'true' : 'false'}
    aria-label="Más secciones"
    aria-haspopup="dialog"
    aria-controls="mobile-more-menu"
    aria-describedby="more-reports-updates"
    aria-expanded="false"
  >
    <span class={`${PILL} relative`}>
      <svg
        class="size-5.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h.01M12 12h.01M19 12h.01" />
      </svg>
      <span
        class="bg-accent ring-panel absolute inset-bs-0.5 inset-e-3 size-2.25 rounded-full ring-2"
        data-reports-badge-dot
        aria-hidden="true"
        hidden
      ></span>
    </span>
    <span class="sr-only">Más</span>
    <span id="more-reports-updates" class="sr-only" data-reports-count-spoken></span>
  </button>
  <span
    class="pointer-events-none absolute inset-y-0 inset-s-1.5 grid w-[calc((100%-0.75rem)/4)] translate-x-[calc(var(--nav-i,0)*100%)] place-items-center opacity-0 group-has-[>[aria-current=page]]/nav:opacity-100 group-has-[>[data-active=true]]/nav:opacity-100 motion-safe:transition-[translate,opacity] motion-safe:duration-[420ms,160ms] motion-safe:ease-[cubic-bezier(0.32,0.72,0,1)]"
    data-nav-indicator
    aria-hidden="true"
  >
    <span class="rounded-pill h-10 w-13 bg-[color-mix(in_oklch,var(--color-accent)_24%,transparent)]"></span>
  </span>
</nav>
