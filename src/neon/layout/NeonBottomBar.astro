---
import { APP_SECTIONS } from '../../config/app-sections'
import type { SectionId } from '../../scripts/types'
import { BAR_SECTION_IDS } from './mobile-sections'
import NavIcon from './NavIcon.astro'

/**
 * Bottom bar of the mobile frame (DESIGN.md, «Barra inferior móvil»): three
 * sections and «Más», as icons in a floating capsule that leaves room for the FAB beside it. `data-primary-sections` tells the
 * shell's navigation script which sections the bar already shows, so «Más»
 * lights up for every other one. «Más» carries a dot while a report has news
 * the person has not read (artboard «hoja «Más» con novedades · móvil»):
 * src/scripts/app/reports-badge.ts shows `[data-reports-badge-dot]` and writes
 * the sentence the button is described by into `[data-reports-count-spoken]`.
 */
export interface Props {
  activeSection: SectionId | null
}

const { activeSection } = Astro.props
const sections = BAR_SECTION_IDS.map((id) => APP_SECTIONS.find((section) => section.id === id)!)
const moreIsActive = activeSection !== null && !BAR_SECTION_IDS.includes(activeSection)

const ITEM =
  'group text-muted aria-[current=page]:text-text data-[active=true]:text-text outline-accent flex min-h-12 min-w-0 flex-1 items-center justify-center rounded-full focus-visible:outline-2 focus-visible:-outline-offset-2 motion-safe:transition-transform motion-safe:duration-140 motion-safe:ease-out motion-safe:active:scale-[0.97]'
const PILL =
  'grid h-10 w-13 place-items-center rounded-pill group-aria-[current=page]:bg-[color-mix(in_oklch,var(--color-accent)_24%,transparent)] group-data-[active=true]:bg-[color-mix(in_oklch,var(--color-accent)_24%,transparent)] motion-safe:transition-colors motion-safe:duration-140 motion-safe:ease-out'
---

<nav
  class="bg-panel border-line frame:hidden fixed inset-s-3 inset-e-3 inset-be-[calc(16px+env(safe-area-inset-bottom,0px))] z-30 flex h-16 items-center rounded-full border px-1.5 shadow-[0_10px_24px_oklch(0%_0_none/0.35)] [:root:has([data-fab-apuntar]):not(:has([data-bottom-dock]))_&]:inset-e-[84px]"
  aria-label="Navegación principal"
>
  {sections.map((section) => (
    <button
      type="button"
      class={ITEM}
      data-nav-item
      data-section={section.id}
      aria-controls={section.id}
      aria-current={section.id === activeSection ? 'page' : undefined}
    >
      <span class={PILL}>
        <span class="size-5.5 [&>svg]:size-full">
          <NavIcon sectionId={section.id} />
        </span>
      </span>
      <span class="sr-only">{section.label}</span>
    </button>
  ))}
  <button
    type="button"
    class={ITEM}
    data-mobile-more-trigger
    data-primary-sections={BAR_SECTION_IDS.join(',')}
    data-active={moreIsActive ? 'true' : 'false'}
    aria-label="Más secciones"
    aria-haspopup="dialog"
    aria-controls="mobile-more-menu"
    aria-describedby="more-reports-updates"
    aria-expanded="false"
  >
    <span class={`${PILL} relative`}>
      <svg
        class="size-5.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h.01M12 12h.01M19 12h.01" />
      </svg>
      <span
        class="bg-accent ring-panel absolute inset-bs-0.5 inset-e-3 size-2.25 rounded-full ring-2"
        data-reports-badge-dot
        aria-hidden="true"
        hidden
      ></span>
    </span>
    <span class="sr-only">Más</span>
    <span id="more-reports-updates" class="sr-only" data-reports-count-spoken></span>
  </button>
</nav>
