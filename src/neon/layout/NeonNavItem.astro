---
import type { AppSectionConfig } from '../../config/app-sections'
import type { SectionId } from '../../scripts/types'
import NavIcon from './NavIcon.astro'

/** One section of the sidebar. `data-nav-item` / `data-section` are what the shell's navigation script binds to. */
export interface Props {
  section: AppSectionConfig
  activeSection: SectionId | null
}

const { section, activeSection } = Astro.props
---

<button
  type="button"
  class="rounded-field text-soft aria-[current=page]:bg-nav-active-bg aria-[current=page]:text-nav-active-text not-aria-[current=page]:pointer-fine:hover:bg-panel2 not-aria-[current=page]:pointer-fine:hover:text-text outline-accent flex min-h-11.5 w-full items-center gap-3 px-3.5 text-start text-[15px] font-semibold aria-[current=page]:font-bold focus-visible:outline-2 focus-visible:-outline-offset-2 motion-safe:transition-[transform,background-color,color] motion-safe:duration-140 motion-safe:ease-out motion-safe:active:scale-[0.96]"
  data-nav-item
  data-section={section.id}
  aria-controls={section.id}
  aria-current={section.id === activeSection ? 'page' : undefined}
>
  <span class="size-5 shrink-0 [&>svg]:size-full">
    <NavIcon sectionId={section.id} />
  </span>
  <span class="truncate">{section.label}</span>
</button>
