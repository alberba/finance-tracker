---
import { APP_SECTIONS } from '../../config/app-sections'
import type { Design } from '../../lib/design'
import type { SectionId } from '../../scripts/types'
import { BAR_SECTION_IDS } from './mobile-sections'
import DesignToggle from './DesignToggle.vue'
import NeonNavItem from './NeonNavItem.astro'

/**
 * «Más» sheet of the mobile frame: every section the bottom bar leaves out and
 * the design toggle. The ids and data attributes are what src/scripts/shell.ts
 * binds to (same contract as the old design's sheet): it opens with
 * `showModal()` from `[data-mobile-more-trigger]` and closes on the scrim, on
 * `[data-mobile-more-close]` and on any `[data-section]` inside.
 */
export interface Props {
  activeSection: SectionId | null
  design: Design
}

const { activeSection, design } = Astro.props
const sections = APP_SECTIONS.filter((section) => !BAR_SECTION_IDS.includes(section.id))
---

<dialog
  id="mobile-more-menu"
  class="bg-panel text-text rounded-t-sheet shadow-sheet mx-auto mbs-auto mbe-0 max-h-[min(82dvh,720px)] w-full max-w-140 overflow-y-auto overscroll-contain px-4 pbs-2.5 pbe-[calc(22px+env(safe-area-inset-bottom,0px))] backdrop:bg-[oklch(0%_none_none/0.55)] motion-safe:open:animate-sheet-in"
  aria-label="Más secciones"
>
  <div class="bg-ctrl-line mx-auto mbe-3.5 h-1 w-9 rounded-pill" aria-hidden="true"></div>
  <header class="mbe-3 flex items-center justify-between gap-3">
    <h2 class="font-display text-h1-detail leading-[1.15] font-bold tracking-h1">Más</h2>
    <button
      type="button"
      class="border-ctrl-line text-soft outline-accent grid size-11 shrink-0 place-items-center rounded-full border focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:transition-transform motion-safe:duration-140 motion-safe:ease-out motion-safe:active:scale-[0.97]"
      data-mobile-more-close
      aria-label="Cerrar menú"
    >
      <svg
        class="size-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
  </header>

  <nav class="grid grid-cols-2 gap-1" aria-label="Más secciones">
    {sections.map((section) => (
      <NeonNavItem section={section} activeSection={activeSection} />
    ))}
  </nav>

  <section class="mbs-5 grid gap-2" aria-labelledby="mobile-design-title">
    <h3
      id="mobile-design-title"
      class="text-muted text-label font-extrabold tracking-label uppercase"
    >
      Diseño
    </h3>
    <DesignToggle client:only="vue" design={design} />
  </section>
</dialog>
