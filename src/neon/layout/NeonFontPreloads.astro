---
/**
 * Preloads the faces (src/styles/common.css, public/fonts):
 * Unbounded for titles and figures, Manrope for text. Mounted by the shell.
 */
---

<link
  rel="preload"
  href="/fonts/unbounded-latin-wght.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="/fonts/manrope-latin-wght.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
