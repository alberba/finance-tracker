---
/**
 * Self-hosted faces (src/styles/global.css, public/fonts). Preloading them
 * starts the download before the browser reaches the @font-face rules, so the
 * swap is less likely to show. Shared by the app shell and the login page; the
 * italic face is not above the fold, and `mono` is only set by the shell.
 */
export interface Props {
  mono?: boolean
}

const { mono = false } = Astro.props
---

<link
  rel="preload"
  href="/fonts/syne-latin-wght.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="/fonts/dm-sans-latin-wght.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
{mono && (
  <link
    rel="preload"
    href="/fonts/dm-mono-latin-400.woff2"
    as="font"
    type="font/woff2"
    crossorigin="anonymous"
  />
)}
{mono && (
  <link
    rel="preload"
    href="/fonts/dm-mono-latin-500.woff2"
    as="font"
    type="font/woff2"
    crossorigin="anonymous"
  />
)}
