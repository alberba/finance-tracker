---
import type { SectionId } from '../../scripts/types'
import SidebarNav from './SidebarNav.astro'
import SidebarUserMenu from './SidebarUserMenu.astro'

export interface Props {
  activeSection: SectionId
}

const { activeSection } = Astro.props
---

<aside class="sidebar">
  <header class="brand-block">
    <span class="brand-logo" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 16l4.5-4.5 3 3L20 7"></path>
        <path d="M15 7h5v5"></path>
      </svg>
    </span>
    <h1>Finance<br />Tracker</h1>
  </header>
  <div class="sidebar-collapsed-brand" aria-hidden="true">
    <img src="/favicon.svg" alt="" />
  </div>

  <SidebarNav activeSection={activeSection} />

  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar tema">
    <svg
      class="theme-toggle-icon-moon"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <path d="M16 11.5A6 6 0 0 1 8.5 4a6 6 0 1 0 7.5 7.5z"></path>
    </svg>
    <svg
      class="theme-toggle-icon-sun"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <circle cx="10" cy="10" r="3.4"></circle>
      <path
        d="M10 2v2M10 16v2M2 10h2M16 10h2M4.5 4.5l1.4 1.4M14.1 14.1l1.4 1.4M4.5 15.5l1.4-1.4M14.1 5.9l1.4-1.4"
      ></path>
    </svg>
    <span class="theme-toggle-label">Modo oscuro</span>
    <span class="theme-toggle-switch" aria-hidden="true"></span>
  </button>

  <button
    id="sidebar-toggle"
    class="sidebar-toggle"
    type="button"
    aria-label="Colapsar barra lateral"
    aria-expanded="true"
  >
    <svg
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <polyline points="13,4 7,10 13,16"></polyline>
      <polyline points="8,4 2,10 8,16"></polyline>
    </svg>
    <span class="sidebar-toggle-label">Colapsar</span>
  </button>

  <SidebarUserMenu />
</aside>
