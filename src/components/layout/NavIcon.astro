---
import type { SectionId } from '../../scripts/types'

export interface Props {
  sectionId: SectionId
}

const { sectionId } = Astro.props
---

{
  sectionId === 'dashboard' && (
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="3" y="3" width="6" height="6" rx="1.2" />
      <rect x="11" y="3" width="6" height="6" rx="1.2" />
      <rect x="3" y="11" width="6" height="6" rx="1.2" />
      <rect x="11" y="11" width="6" height="6" rx="1.2" />
    </svg>
  )
}
{
  sectionId === 'transactions' && (
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M7 3v14M7 17l-3-3m3 3 3-3M13 17V3M13 3l-3 3m3-3 3 3" />
    </svg>
  )
}
{
  sectionId === 'budget' && (
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="10" cy="10" r="7" />
      <path d="M10 3v7l4.5 2.6" />
    </svg>
  )
}
{
  sectionId === 'wealth' && (
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M2 9.5 10 4l8 5.5" />
      <rect x="4" y="9.5" width="12" height="7" rx="1" />
      <rect x="8" y="13" width="4" height="3.5" />
    </svg>
  )
}
{
  sectionId === 'investment' && (
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
      <polyline points="2,14 7,9 11,12 18,5" />
      <polyline points="14,5 18,5 18,9" />
    </svg>
  )
}
{
  sectionId === 'goals' && (
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="10" cy="10" r="7" />
      <circle cx="10" cy="10" r="3.5" />
      <circle cx="10" cy="10" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  sectionId === 'settings' && (
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="10" cy="10" r="2.5" />
      <path d="M10 3v1.5M10 15.5V17M3 10h1.5M15.5 10H17M4.93 4.93l1.06 1.06M14 14l1.07 1.07M4.93 15.07l1.06-1.06M14 6l1.07-1.07" />
    </svg>
  )
}
{
  sectionId === 'data' && (
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
      <ellipse cx="10" cy="6" rx="7" ry="2.5" />
      <path d="M3 6v4c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5V6" />
      <path d="M3 10v4c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5v-4" />
    </svg>
  )
}
