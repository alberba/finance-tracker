---
import '../styles/global.css'
import AppSidebar from './layout/AppSidebar.astro'
import MobileNavigation from './layout/MobileNavigation.astro'
import FinanceWorkspace from './FinanceWorkspace.vue'
import { getSectionFromPath } from '../scripts/app/dashboard-section-routing'

const canonicalUrl = new URL('/', Astro.url).toString()
const activeSection = getSectionFromPath(Astro.url.pathname)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Theme and sidebar before the first paint. Same rule as
      // src/lib/client/theme.ts: a stored light/dark wins, anything else
      // ("system" or nothing) follows prefers-color-scheme.
      ;(function () {
        const root = document.documentElement
        try {
          const stored = localStorage.getItem('theme')
          const prefersDark =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
          root.dataset.theme =
            stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light'
          root.dataset.sidebar =
            localStorage.getItem('sidebar-collapsed') === 'true' ? 'collapsed' : 'expanded'
        } catch {
          root.dataset.theme = 'light'
          root.dataset.sidebar = 'expanded'
        }
      })()
    </script>
    <script is:inline>
      // Modo demo: `?demo=1` activa (persistente), `?demo=0` desactiva. Debe
      // correr antes que los scripts de la app para fijar el namespace `demo`
      // (datos sintéticos aislados) antes de la hidratación del estado.
      ;(function () {
        try {
          const params = new URLSearchParams(window.location.search)
          const flag = params.get('demo')
          if (flag !== null) {
            if (['1', 'on', 'true'].includes(flag.toLowerCase())) {
              localStorage.setItem('finance-demo-mode', '1')
              document.cookie =
                'finance-demo-mode=1; Path=/; Max-Age=2592000; SameSite=Lax' +
                (window.location.protocol === 'https:' ? '; Secure' : '')
            } else {
              localStorage.removeItem('finance-demo-mode')
              document.cookie =
                'finance-demo-mode=; Path=/; Max-Age=0; SameSite=Lax' +
                (window.location.protocol === 'https:' ? '; Secure' : '')
            }
            params.delete('demo')
            const query = params.toString()
            history.replaceState(
              null,
              '',
              window.location.pathname + (query ? '?' + query : '') + window.location.hash,
            )
          }
          if (!window.__FINANCE_NAMESPACE__ && localStorage.getItem('finance-demo-mode') === '1') {
            window.__FINANCE_NAMESPACE__ = 'demo'
            document.documentElement.dataset.demo = '1'
            document.cookie =
              'finance-demo-mode=1; Path=/; Max-Age=2592000; SameSite=Lax' +
              (window.location.protocol === 'https:' ? '; Secure' : '')
          }
        } catch {
          /* storage no disponible — sin modo demo */
        }
      })()
    </script>
    <meta name="theme-color" content="#090B10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#EEF1F6" media="(prefers-color-scheme: light)" />
    <title>Finance Tracker 2026</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <meta name="application-name" content="Finance Tracker" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script>
      import '../scripts/app'
      import '../scripts/shell'
    </script>
  </head>
  <body>
    <a
      class="bg-primary-fill text-on-primary fixed top-3 left-3 z-1000 -translate-y-20 rounded-md px-3.5 py-2 text-sm font-bold focus:translate-y-0"
      href="#app-main">Saltar al contenido</a
    >
    <div
      class="sidebar-collapsed:desk:grid-cols-[72px_minmax(0,1fr)] desk:grid-cols-[256px_minmax(0,1fr)] grid min-h-screen grid-cols-1 overflow-x-clip"
    >
      <div id="nav-tabs" class="contents">
        <AppSidebar activeSection={activeSection} />
        <MobileNavigation activeSection={activeSection} />
      </div>

      <div class="flex min-w-0 flex-col">
        <div
          id="demo-banner"
          class="bg-notice text-notice-text border-notice-line border-b"
          role="status"
          hidden
        >
          <div
            class="mx-auto flex max-w-7xl items-center gap-3 py-1.5 pr-2 pl-4 md:px-[clamp(16px,3vw,40px)]"
          >
            <span class="bg-accent size-2 shrink-0 rounded-full" aria-hidden="true"></span>
            <p class="min-w-0 flex-1 text-sm">
              <span class="font-mono text-xs font-medium tracking-[0.14em] uppercase"
                >Modo demo</span
              >{' · '}datos ficticios
            </p>
            <button
              id="demo-banner-exit"
              class="border-notice-line hover:bg-notice-line min-h-11 shrink-0 rounded-sm px-3 text-sm font-bold md:min-h-9 md:border"
              type="button"
            >
              Salir<span class="max-md:hidden"> del modo demo</span>
            </button>
          </div>
        </div>

        <main
          id="app-main"
          class="desk:pb-14 grid min-w-0 content-start gap-5 px-3.25 pt-4.5 pb-[calc(104px+env(safe-area-inset-bottom))] md:px-[clamp(16px,3vw,40px)] md:pt-7.5"
        >
          <FinanceWorkspace activeSection={activeSection} client:only="vue" />
        </main>
      </div>
    </div>

    <!-- A manual popover, so it renders in the top layer above an open side
         panel or confirmation (both modal dialogs). top/margin/size undo the
         popover's centring from the browser stylesheet. -->
    <div
      id="toast"
      popover="manual"
      class="bg-ink text-ink-text border-ink-line shadow-pop desk:right-24 desk:bottom-6 desk:left-auto desk:max-w-90 pointer-events-none fixed inset-x-4 top-auto bottom-[calc(96px+env(safe-area-inset-bottom))] z-60 m-0 h-auto w-auto translate-y-2.5 overflow-visible rounded-md border px-4.5 py-3 text-[0.9375rem] leading-snug opacity-0 transition duration-200 data-visible:translate-y-0 data-visible:opacity-100"
      role="status"
      aria-live="polite"
    >
    </div>
    <div
      id="chart-tooltip"
      class="bg-ink text-ink-text border-ink-line shadow-pop pointer-events-none invisible fixed z-1200 max-w-[min(280px,78vw)] translate-y-1 rounded-md border px-3.5 py-2.5 text-[0.8125rem] leading-snug opacity-0 transition duration-150 data-visible:visible data-visible:translate-y-0 data-visible:opacity-100"
      role="tooltip"
      aria-hidden="true"
    >
    </div>
  </body>
</html>
