---
import BudgetSection from "./sections/BudgetSection.astro";
import DashboardSection from "./sections/DashboardSection.astro";
import DataSection from "./sections/DataSection.astro";
import GoalsSection from "./sections/GoalsSection.astro";
import InvestmentSection from "./sections/InvestmentSection.astro";
import ReportsSection from "./reports/ReportsSection.astro";
import SettingsSection from "./sections/SettingsSection.astro";
import TransactionsSection from "./sections/TransactionsSection.astro";
import WealthSection from "./sections/WealthSection.astro";

export interface Props {
  activeRoute?: "root" | "section";
  sectionParam?: string;
}

const { activeRoute = "root", sectionParam = "" } = Astro.props;
const canonicalUrl = new URL("/", Astro.url).toString();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Finance Tracker 2026</title>
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script>
    import "../scripts/app";
    import "../scripts/issue-report";
  </script>
</head>
<body data-route={activeRoute} data-section={sectionParam}>
  <a class="skip-link" href="#app-main">Saltar al contenido</a>
  <div class="bg-layer"></div>
  <div class="app-shell">
    <aside class="sidebar">
      <header class="brand-block">
        <p class="brand-kicker">Plan financiero</p>
        <h1>Finance Tracker</h1>
        <p class="brand-sub">Reemplazo completo de tu Excel con una experiencia más clara y rápida.</p>
      </header>

      <nav class="nav" id="nav-tabs" aria-label="Secciones del tracker">
        <button type="button" class="nav-btn is-active" data-section="dashboard" aria-controls="dashboard" aria-current="page">Dashboard</button>
        <button type="button" class="nav-btn" data-section="transactions" aria-controls="transactions">Movimientos</button>
        <button type="button" class="nav-btn" data-section="budget" aria-controls="budget">Presupuesto</button>
        <button type="button" class="nav-btn" data-section="wealth" aria-controls="wealth">Patrimonio</button>
        <button type="button" class="nav-btn" data-section="investment" aria-controls="investment">Inversión</button>
        <button type="button" class="nav-btn" data-section="goals" aria-controls="goals">Objetivos</button>
        <button type="button" class="nav-btn" data-section="settings" aria-controls="settings">Configuración</button>
        <button type="button" class="nav-btn" data-section="data" aria-controls="data">Datos</button>
        <button type="button" class="nav-btn" data-section="reports" aria-controls="reports">Reportes</button>
      </nav>

      <footer class="sidebar-footer">
        <p id="save-status">Sincronizado</p>
      </footer>
    </aside>

    <main id="app-main" class="content">
      <DashboardSection />
      <TransactionsSection />
      <BudgetSection />
      <WealthSection />
      <InvestmentSection />
      <GoalsSection />
      <SettingsSection />
      <DataSection />
      <ReportsSection />
    </main>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>
  <div id="chart-tooltip" class="chart-tooltip" role="tooltip" aria-hidden="true"></div>
</body>
</html>
