---
import "../styles/global.css";
import AppSidebar from "./layout/AppSidebar.astro";
import MobileNavigation from "./layout/MobileNavigation.astro";
import FinanceWorkspace from "./FinanceWorkspace.vue";
import { getSectionFromPath } from "../scripts/app/dashboard-section-routing";

const canonicalUrl = new URL("/", Astro.url).toString();
const activeSection = getSectionFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark =
      window.matchMedia &&
      window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme =
            stored || (prefersDark ? "dark" : "light");
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <meta
      name="theme-color"
      content="#07080B"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#EEF1F6"
      media="(prefers-color-scheme: light)"
    />
    <title>Finance Tracker 2026</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="Finance Tracker" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script>
      import "../scripts/app";
      import "../scripts/shell";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#app-main">Saltar al contenido</a>
    <div class="bg-layer"></div>
    <div class="app-shell">
      <div id="nav-tabs" class="app-navigation">
        <AppSidebar activeSection={activeSection} />
        <MobileNavigation activeSection={activeSection} />
      </div>

      <main id="app-main" class="content">
        <FinanceWorkspace activeSection={activeSection} client:only="vue" />
      </main>
    </div>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <div
      id="chart-tooltip"
      class="chart-tooltip"
      role="tooltip"
      aria-hidden="true"
    >
    </div>
  </body>
</html>
