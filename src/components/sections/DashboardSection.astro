<section id="dashboard" class="panel is-active dash" aria-labelledby="dashboard-title">
  <header class="dash-masthead">
    <div class="dash-masthead-titles">
      <p class="dash-eyebrow">Tu resumen financiero</p>
      <h2 id="dashboard-title">Resumen mensual y anual</h2>
    </div>
    <div class="dash-period">
      <label class="dash-period-field">
        <span>Año</span>
        <input id="year-display" name="yearDisplay" type="number" min="2000" max="2100" autocomplete="off" />
      </label>
      <label class="dash-period-field">
        <span>Mes</span>
        <select id="dashboard-month" name="dashboardMonth"></select>
      </label>
    </div>
  </header>

  <!-- HERO · Patrimonio neto -->
  <section class="dash-hero" aria-label="Patrimonio neto">
    <div class="dash-hero-main">
      <p class="dash-hero-label">Patrimonio neto</p>
      <div class="dash-hero-figure">
        <strong id="kpi-net-worth" class="dash-hero-number">€0</strong>
        <span id="kpi-net-worth-change" class="kpi-networth-change">0%</span>
      </div>
      <p class="dash-hero-sub">
        <span>vs año anterior</span>
        <span class="dash-hero-dot" aria-hidden="true">·</span>
        <span>Ahorro anual <strong id="kpi-annual-savings">€0</strong></span>
      </p>
    </div>
    <div class="dash-hero-chart">
      <canvas id="chart-networth" aria-label="Evolución de patrimonio neto"></canvas>
    </div>
  </section>

  <!-- TRES CIFRAS EDITORIALES -->
  <section class="dash-stats" aria-label="Resumen del mes">
    <article class="dash-stat dash-stat--income">
      <p class="dash-stat-label">Ingresos</p>
      <strong id="kpi-income" class="dash-stat-number">€0</strong>
      <span class="dash-stat-rule" aria-hidden="true"></span>
    </article>
    <article class="dash-stat dash-stat--expense">
      <p class="dash-stat-label">Gastos</p>
      <strong id="kpi-expense" class="dash-stat-number">€0</strong>
      <span class="dash-stat-rule" aria-hidden="true"></span>
    </article>
    <article class="dash-stat dash-stat--investment">
      <p class="dash-stat-label">Inversión</p>
      <strong id="kpi-investment" class="dash-stat-number">€0</strong>
      <span class="dash-stat-rule" aria-hidden="true"></span>
    </article>
  </section>

  <!-- CONTENIDO -->
  <section class="dash-columns">
    <article class="dash-panel">
      <h3 class="dash-panel-title">Top gastos del mes</h3>
      <div id="top-expense-list" class="dash-list"></div>
    </article>

    <article class="dash-panel">
      <h3 class="dash-panel-title">Plan de inversión mensual</h3>
      <div id="investment-progress-list" class="dash-list dash-list--progress"></div>
    </article>

    <article class="dash-panel dash-panel--chart">
      <h3 class="dash-panel-title">Ingresos · Gastos · Inversión</h3>
      <div class="dash-chart-wrap">
        <canvas id="chart-cashflow" aria-label="Flujo mensual de ingresos, gastos e inversión"></canvas>
      </div>
    </article>
  </section>
</section>
