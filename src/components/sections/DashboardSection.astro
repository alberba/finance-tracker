<section id="dashboard" class="panel is-active" aria-labelledby="dashboard-title">
  <div class="panel-head">
    <div>
      <h2 id="dashboard-title">Resumen mensual y anual</h2>
      <p>Visualización equivalente a RESUMEN MENSUAL + RESUMEN ANUAL.</p>
    </div>
    <div class="inline-controls">
      <label>
        Año
        <input id="year-display" name="yearDisplay" type="number" min="2000" max="2100" autocomplete="off" />
      </label>
      <label>
        Mes
        <select id="dashboard-month" name="dashboardMonth"></select>
      </label>
    </div>
  </div>

  <div class="dashboard-kpi-layout" id="kpi-cards">
    <article class="kpi-card kpi-group-card">
      <h3>Resumen del mes</h3>
      <div class="kpi-month-grid">
        <div class="kpi-month-item">
          <p>Ingresos</p>
          <strong id="kpi-income">€0</strong>
        </div>
        <div class="kpi-month-item">
          <p>Gastos</p>
          <strong id="kpi-expense">€0</strong>
        </div>
        <div class="kpi-month-item">
          <p>Inversión</p>
          <strong id="kpi-investment">€0</strong>
        </div>
      </div>
    </article>
    <article class="kpi-card kpi-networth-emphasis">
      <div class="kpi-networth-head">
        <p>Patrimonio neto</p>
        <span id="kpi-net-worth-change" class="kpi-networth-change">0%</span>
      </div>
      <strong id="kpi-net-worth">€0</strong>
      <small>vs año anterior</small>
    </article>
    <article class="kpi-card">
      <p>Ahorro anual</p>
      <strong id="kpi-annual-savings">€0</strong>
    </article>
  </div>

  <div class="chart-grid">
    <div class="chart-stack">
      <article class="chart-card">
        <h3>Evolución patrimonio neto</h3>
        <div class="chart-canvas-wrap"><canvas id="chart-networth" aria-label="Evolución de patrimonio"></canvas></div>
      </article>
      <article class="chart-card">
        <h3>Ingresos vs Gastos vs Inversión</h3>
        <div class="chart-canvas-wrap"><canvas id="chart-cashflow" aria-label="Flujo mensual"></canvas></div>
      </article>
    </div>
    <aside class="chart-side">
      <article class="chart-card top-expense-card">
        <h3>Top gastos del mes</h3>
        <div id="top-expense-list" class="list-stack"></div>
      </article>
      <article class="chart-card investment-progress-card">
        <h3>Plan de inversión mensual</h3>
        <div id="investment-progress-list" class="list-stack"></div>
      </article>
    </aside>
  </div>
</section>
