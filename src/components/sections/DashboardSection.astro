<section id="dashboard" class="panel is-active" aria-labelledby="dashboard-title">
  <div class="panel-head">
    <div>
      <h2 id="dashboard-title">Resumen mensual y anual</h2>
      <p>Visualización equivalente a RESUMEN MENSUAL + RESUMEN ANUAL.</p>
    </div>
    <div class="inline-controls">
      <label>
        Año
        <input id="year-display" name="yearDisplay" type="number" min="2000" max="2100" autocomplete="off" />
      </label>
      <label>
        Mes
        <select id="dashboard-month" name="dashboardMonth"></select>
      </label>
    </div>
  </div>

  <div class="dashboard-kpi-layout" id="kpi-cards">
    <article class="kpi-card kpi-group-card">
      <h3>Resumen del mes</h3>
      <div class="kpi-month-grid">
        <div class="kpi-month-item">
          <p>Ingresos</p>
          <strong id="kpi-income">€0</strong>
        </div>
        <div class="kpi-month-item">
          <p>Gastos</p>
          <strong id="kpi-expense">€0</strong>
        </div>
        <div class="kpi-month-item">
          <p>Inversión</p>
          <strong id="kpi-investment">€0</strong>
        </div>
      </div>
    </article>
    <article class="kpi-card kpi-networth-emphasis">
      <div class="kpi-networth-head">
        <p>Patrimonio neto</p>
        <span id="kpi-net-worth-change" class="kpi-networth-change">0%</span>
      </div>
      <strong id="kpi-net-worth">€0</strong>
      <small>vs año anterior</small>
    </article>
    <article class="kpi-card">
      <p>Ahorro anual</p>
      <strong id="kpi-annual-savings">€0</strong>
    </article>
  </div>

  <div
    data-dashboard-chart-grid
    class="grid items-start gap-3 xl:grid-cols-2"
  >
    <div class="grid min-w-0 gap-3 lg:grid-cols-2">
      <article
        data-dashboard-top-expenses
        class="grid h-full content-start gap-3 rounded-[var(--radius-lg)] border border-[#dce6e1] bg-[var(--bg-panel)] p-3.5 shadow-[var(--shadow-soft)]"
      >
        <h3 class="text-[1.05rem]">Top gastos del mes</h3>
        <div id="top-expense-list" class="grid gap-2 items-start"></div>
      </article>
      <article class="grid gap-3 rounded-[var(--radius-lg)] border border-[#dce6e1] bg-[var(--bg-panel)] p-3.5 shadow-[var(--shadow-soft)]">
        <h3 class="text-[1.05rem]">Plan de inversión mensual</h3>
        <div id="investment-progress-list" class="grid gap-2.5"></div>
      </article>
    </div>
    <div data-dashboard-chart-stack class="grid min-w-0 gap-3">
      <article class="grid gap-3 rounded-[var(--radius-lg)] border border-[#dce6e1] bg-[var(--bg-panel)] p-3.5 shadow-[var(--shadow-soft)]">
        <h3 class="text-[1.05rem]">Evolución patrimonio neto</h3>
        <div class="relative h-[220px] w-full overflow-hidden rounded-xl border border-[#e2ece7] bg-[#fcfefc] p-3">
          <canvas id="chart-networth" class="block !h-full !w-full" aria-label="Evolución de patrimonio"></canvas>
        </div>
      </article>
      <article class="grid gap-3 rounded-[var(--radius-lg)] border border-[#dce6e1] bg-[var(--bg-panel)] p-3.5 shadow-[var(--shadow-soft)]">
        <h3 class="text-[1.05rem]">Ingresos vs Gastos vs Inversión</h3>
        <div class="relative h-[220px] w-full overflow-hidden rounded-xl border border-[#e2ece7] bg-[#fcfefc] p-3">
          <canvas id="chart-cashflow" class="block !h-full !w-full" aria-label="Flujo mensual"></canvas>
        </div>
      </article>
    </div>
  </div>
</section>
