---
import DashboardStatCard from '../dashboard/DashboardStatCard.vue'
import DashboardPanel from '../dashboard/DashboardPanel.astro'
import TopExpenseList from '../dashboard/TopExpenseList.vue'
import DashboardStatExpenseIcon from '../../assets/icons/dashboard-stat-expense.svg'
import DashboardStatIncomeIcon from '../../assets/icons/dashboard-stat-income.svg'
import DashboardStatInvestmentIcon from '../../assets/icons/dashboard-stat-investment.svg'

const statIconClass = 'h-6 w-6 xl:h-8 xl:w-8'
---

<section
  id="dashboard"
  class="panel is-active dash gap-[clamp(18px,2.6vw,28px)]"
  aria-labelledby="dashboard-title">
  <header
    class="dash-masthead flex flex-wrap items-start justify-between gap-5 max-[640px]:flex-col">
    <div class="dash-masthead-titles grid gap-1.5">
      <p
        class="dash-eyebrow font-['DM_Mono',monospace] text-[0.66rem] font-medium tracking-[0.22em] text-(--primary) uppercase">
        ¡Bienvenido de nuevo!
      </p>
      <h2
        id="dashboard-title"
        class="font-['Syne',sans-serif] text-[clamp(1.8rem,3vw,2.6rem)] leading-[1.05] tracking-[-0.035em] text-(--text-main)">
        Resumen financiero
      </h2>
      <p class="dash-subtitle text-[0.92rem] text-(--text-muted)">
        Aquí tienes una visión completa de tu situación financiera.
      </p>
    </div>
    <div class="dash-period flex flex-wrap items-stretch gap-3">
      <label class="dash-period-field grid gap-1">
        <span class="pl-0.5 text-[0.6rem] font-bold tracking-[0.12em] text-(--text-faint) uppercase"
          >Año</span
        >
        <span
          class="dash-period-control relative inline-flex items-center rounded-md border border-(--line) bg-(--bg-panel) [box-shadow:var(--shadow-soft)] focus-within:border-(--primary) focus-within:[box-shadow:0_0_0_3px_var(--ring)]">
          <input
            id="year-display"
            class="w-auto min-w-19.5 appearance-none rounded-md border-0 bg-transparent py-2.25 pr-8.5 pl-3.5 text-[0.95rem] font-semibold text-(--text-main)"
            name="yearDisplay"
            type="number"
            min="2000"
            max="2100"
            autocomplete="off"
          />
          <svg
            class="dash-period-icon pointer-events-none absolute right-2.75 h-3.5 w-3.5 text-(--text-faint)"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true">
            <rect x="3" y="4.5" width="14" height="12" rx="2"></rect>
            <path d="M3 8h14M7 3v3M13 3v3"></path>
          </svg>
        </span>
      </label>
      <label class="dash-period-field grid gap-1">
        <span
          class="pl-0.5 text-[0.6rem] font-bold tracking-[0.12em] text-(--text-faint) uppercase">
          Mes
        </span>
        <span
          class="dash-period-control relative inline-flex items-center rounded-md border border-(--line) bg-(--bg-panel) [box-shadow:var(--shadow-soft)] focus-within:border-(--primary) focus-within:[box-shadow:0_0_0_3px_var(--ring)]">
          <select
            id="dashboard-month"
            class="w-auto min-w-23 appearance-none rounded-md border-0 bg-transparent py-2.25 pr-8.5 pl-3.5 text-[0.95rem] font-semibold text-(--text-main)"
            name="dashboardMonth"></select>
          <svg
            class="dash-period-icon pointer-events-none absolute right-2.75 h-3.5 w-3.5 text-(--text-faint)"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true">
            <path d="M5 8l5 5 5-5"></path>
          </svg>
        </span>
      </label>
    </div>
  </header>

  <!-- HERO · Patrimonio neto -->
  <section
    class="dash-hero grid grid-cols-[minmax(240px,0.85fr)_minmax(0,1.15fr)] items-center gap-[clamp(20px,3vw,44px)] rounded-lg border border-(--line) bg-(--bg-panel) p-[clamp(22px,2.6vw,34px)] [box-shadow:var(--shadow-soft)] max-[1080px]:grid-cols-1"
    aria-label="Patrimonio neto">
    <div class="dash-hero-main grid min-w-0 gap-2.5">
      <p
        class="dash-hero-label inline-flex items-center gap-1.5 text-[0.95rem] font-semibold text-(--text-muted)">
        Patrimonio neto
        <svg
          class="dash-hero-info h-3 w-3 flex-none text-(--text-faint)"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.35"
          aria-hidden="true"
          ><circle cx="10" cy="10" r="7"></circle><path d="M10 9.2v4"></path><circle
            cx="10"
            cy="6.5"
            r="0.7"
            fill="currentColor"
            stroke="none"></circle></svg
        >
      </p>
      <strong
        id="kpi-net-worth"
        class="dash-hero-number text-[clamp(2.2rem,5vw,3.4rem)] leading-none font-bold tracking-[-0.03em] text-(--text-main) tabular-nums">
        €0
      </strong>
      <p class="dash-hero-meta flex flex-wrap items-center gap-2.5">
        <span
          id="kpi-net-worth-change"
          class="kpi-networth-change rounded-full bg-(--income-bg) px-2.25 py-0.75 font-['DM_Mono',monospace] text-[0.875rem] font-medium text-(--income) tabular-nums"
          >0%</span
        >
        <span class="dash-hero-meta-text text-[0.88rem] text-(--text-muted)">vs. año anterior</span>
      </p>
      <p class="dash-hero-sub text-[0.9rem] text-(--text-muted)">
        Ahorro anual: <strong
          id="kpi-annual-savings"
          class="font-bold text-(--primary) tabular-nums">€0</strong
        >
      </p>
    </div>
    <div class="dash-hero-right grid min-w-0 gap-2.5">
      <div
        class="dash-range inline-flex gap-0.5 justify-self-end rounded-full border border-(--line) bg-(--bg-subtle) p-0.75 max-[1080px]:justify-self-start"
        role="group"
        aria-label="Rango temporal del gráfico">
        <button
          type="button"
          class="dash-range-btn min-h-0 rounded-full bg-transparent px-3.25 py-1.25 text-[0.74rem] font-bold text-(--text-muted) transition-colors hover:text-(--text-main) [&.is-active]:bg-(--bg-panel) [&.is-active]:text-(--primary) [&.is-active]:[box-shadow:var(--shadow-soft)]"
          data-range="7d">7D</button
        >
        <button
          type="button"
          class="dash-range-btn min-h-0 rounded-full bg-transparent px-3.25 py-1.25 text-[0.74rem] font-bold text-(--text-muted) transition-colors hover:text-(--text-main) [&.is-active]:bg-(--bg-panel) [&.is-active]:text-(--primary) [&.is-active]:[box-shadow:var(--shadow-soft)]"
          data-range="1m">1M</button
        >
        <button
          type="button"
          class="dash-range-btn min-h-0 rounded-full bg-transparent px-3.25 py-1.25 text-[0.74rem] font-bold text-(--text-muted) transition-colors hover:text-(--text-main) [&.is-active]:bg-(--bg-panel) [&.is-active]:text-(--primary) [&.is-active]:[box-shadow:var(--shadow-soft)]"
          data-range="6m">6M</button
        >
        <button
          type="button"
          class="dash-range-btn is-active min-h-0 rounded-full bg-transparent px-3.25 py-1.25 text-[0.74rem] font-bold text-(--text-muted) transition-colors hover:text-(--text-main) [&.is-active]:bg-(--bg-panel) [&.is-active]:text-(--primary) [&.is-active]:[box-shadow:var(--shadow-soft)]"
          data-range="1a">1A</button
        >
      </div>
      <div class="dash-hero-chart relative h-[clamp(160px,16vw,220px)] min-w-0">
        <span
          id="networth-endpoint"
          class="dash-hero-tip absolute top-1 right-1 z-2 rounded-full border border-[color-mix(in_srgb,var(--primary)_30%,transparent)] bg-(--primary-light) px-2.25 py-1 font-['DM_Mono',monospace] text-[0.74rem] font-medium text-(--primary) tabular-nums"
          aria-hidden="true">€0</span
        >
        <canvas
          id="chart-networth"
          class="absolute inset-0 h-full! w-full!"
          aria-label="Evolución de patrimonio neto"></canvas>
      </div>
    </div>
  </section>

  <!-- TRES CIFRAS -->
  <section
    class="dash-stats grid grid-cols-3 gap-4 max-[860px]:grid-cols-1"
    aria-label="Resumen del mes">
    <DashboardStatCard
      variant="income"
      label="Ingresos"
      valueId="kpi-income"
      deltaId="kpi-income-delta"
      sparkId="spark-income">
      <DashboardStatIncomeIcon slot="icon" class={statIconClass} />
    </DashboardStatCard>

    <DashboardStatCard
      variant="expense"
      label="Gastos"
      valueId="kpi-expense"
      deltaId="kpi-expense-delta"
      sparkId="spark-expense">
      <DashboardStatExpenseIcon slot="icon" class={statIconClass} />
    </DashboardStatCard>

    <DashboardStatCard
      variant="investment"
      label="Ahorro o inversión"
      valueId="kpi-investment"
      deltaId="kpi-investment-delta"
      sparkId="spark-investment">
      <DashboardStatInvestmentIcon slot="icon" class={statIconClass} />
    </DashboardStatCard>
  </section>

  <!-- CUATRO PANELES -->
  <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <DashboardPanel
      title="Distribución de patrimonio"
      actionLabel="Ver detalle de patrimonio"
      actionTarget="wealth"
      class="gap-3.5">
      <div class="dash-donut-wrap relative h-[clamp(136px,12vw,158px)]">
        <canvas
          id="chart-wealth-split"
          class="absolute inset-0 h-full! w-full!"
          aria-label="Distribución del patrimonio"></canvas>
      </div>
      <div id="wealth-split-legend" class="wealth-legend grid gap-2.25"></div>
    </DashboardPanel>

    <DashboardPanel
      title="Top gastos del mes"
      actionLabel="Ver todos los gastos"
      actionTarget="transactions"
      class="gap-3">
      <TopExpenseList client:load />
    </DashboardPanel>

    <DashboardPanel
      title="Plan de inversión mensual"
      actionLabel="Ver plan completo"
      actionTarget="budget"
      class="gap-3">
      <div
        id="investment-progress-list"
        class="flex min-h-0 gap-3 flex-col justify-between">
      </div>
    </DashboardPanel>

    <DashboardPanel
      title="Ingresos, gastos e inversión"
      actionLabel="Ver análisis detallado"
      actionTarget="reports"
      class="dash-panel--chart justify-start gap-3.5">
      <div class="dash-chart-wrap relative mt-0.5 grow min-h-52.5">
        <canvas
          id="chart-cashflow"
          class="absolute inset-0 h-full! w-full!"
          aria-label="Flujo mensual de ingresos, gastos e inversión"></canvas>
      </div>
    </DashboardPanel>
  </section>

  <!-- DOS PANELES INFERIORES -->
  <section
    class="dash-panels-2 grid grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] items-start gap-[clamp(14px,1.6vw,20px)] max-[1200px]:grid-cols-1">
    <article
      class="dash-panel dash-panel--wide flex min-w-0 flex-col gap-3.5 rounded-lg border border-(--line) bg-(--bg-panel) p-[clamp(18px,1.9vw,24px)] [box-shadow:var(--shadow-soft)]">
      <h3 class="dash-panel-title text-base font-bold tracking-[-0.01em] text-(--text-main)">
        Últimos movimientos
      </h3>
      <div class="recent-tx-wrap -mt-0.5 max-w-full min-w-0 overflow-x-auto">
        <table
          class="recent-tx w-full border-collapse text-[0.86rem] [&_tbody_td]:border-b [&_tbody_td]:border-(--line) [&_tbody_td]:py-2.5 [&_tbody_td]:pr-3 [&_tbody_td]:pl-0 [&_tbody_td]:align-middle [&_tbody_tr:last-child_td]:border-b-0 [&_thead_th]:border-b [&_thead_th]:border-(--line) [&_thead_th]:px-0 [&_thead_th]:pt-0 [&_thead_th]:pr-3 [&_thead_th]:pb-2 [&_thead_th]:text-left [&_thead_th]:text-[0.64rem] [&_thead_th]:font-bold [&_thead_th]:tracking-[0.08em] [&_thead_th]:whitespace-nowrap [&_thead_th]:text-(--text-faint) [&_thead_th]:uppercase">
          <thead>
            <tr>
              <th scope="col">Fecha</th>
              <th scope="col">Descripción</th>
              <th scope="col">Categoría</th>
              <th scope="col">Tipo</th>
              <th scope="col" class="num pr-0! text-right!">Importe</th>
            </tr>
          </thead>
          <tbody id="recent-tx-body"></tbody>
        </table>
      </div>
      <button
        type="button"
        class="dash-more mt-auto inline-flex min-h-0 items-center gap-1.5 border-t border-(--line) bg-transparent px-0 pt-3 pb-0 text-[0.85rem] font-semibold text-(--primary) [&_svg]:h-3.5 [&_svg]:w-3.5 [&_svg]:transition-transform hover:[&_svg]:translate-x-0.75"
        data-goto="transactions"
        >Ver todos los movimientos
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg
        >
      </button>
    </article>

    <article
      class="dash-panel flex min-w-0 flex-col justify-start gap-3.5 rounded-lg border border-(--line) bg-(--bg-panel) p-[clamp(18px,1.9vw,24px)] [box-shadow:var(--shadow-soft)]">
      <h3 class="dash-panel-title text-base font-bold tracking-[-0.01em] text-(--text-main)">
        Objetivo de ahorro
      </h3>
      <div
        id="savings-goal"
        class="savings-goal flex flex-wrap items-center gap-[clamp(18px,2.2vw,30px)] px-0 pt-2.5 pb-1.5">
      </div>
      <button
        type="button"
        class="dash-more mt-auto inline-flex min-h-0 items-center gap-1.5 border-t border-(--line) bg-transparent px-0 pt-3 pb-0 text-[0.85rem] font-semibold text-(--primary) [&_svg]:h-3.5 [&_svg]:w-3.5 [&_svg]:transition-transform hover:[&_svg]:translate-x-0.75"
        data-goto="goals"
        >Ver todos los objetivos
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg
        >
      </button>
    </article>
  </section>
</section>
