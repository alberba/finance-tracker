<section id="wealth" class="panel" aria-labelledby="wealth-title">
  <div class="panel-head">
    <div>
      <h2 id="wealth-title">Patrimonio total</h2>
      <p>Liquidez + inversión - deuda, con snapshots mensuales manuales.</p>
    </div>
    <div class="inline-controls">
      <label>
        Mes snapshot
        <select id="snapshot-month" name="snapshotMonth"></select>
      </label>
      <button id="save-snapshot" class="primary-btn" type="button">Guardar snapshot</button>
    </div>
  </div>

  <div class="dual-grid">
    <article class="card">
      <h3>Liquidez</h3>
      <div class="table-wrap compact">
        <table>
          <thead>
            <tr>
              <th>Cuenta</th>
              <th>Apertura</th>
              <th>Calculado</th>
              <th>Snapshot</th>
            </tr>
          </thead>
          <tbody id="snapshot-accounts"></tbody>
        </table>
      </div>
    </article>
    <article class="card">
      <h3>Inversión</h3>
      <div class="table-wrap compact">
        <table>
          <thead>
            <tr>
              <th>Activo</th>
              <th>Apertura</th>
              <th>Calculado</th>
              <th>Snapshot</th>
            </tr>
          </thead>
          <tbody id="snapshot-investments"></tbody>
        </table>
      </div>
    </article>
    <article class="card">
      <h3>Deuda / Pasivos</h3>
      <div class="table-wrap compact">
        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Apertura</th>
              <th>Calculado</th>
              <th>Snapshot</th>
            </tr>
          </thead>
          <tbody id="snapshot-liabilities"></tbody>
        </table>
      </div>
    </article>
    <article class="card">
      <h3>Evolución mensual</h3>
      <div class="chart-canvas-wrap"><canvas id="chart-wealth" aria-label="Evolución mensual patrimonio"></canvas></div>
      <div class="table-wrap compact">
        <table>
          <thead>
            <tr>
              <th>Mes</th>
              <th>Liquidez</th>
              <th>Inversión</th>
              <th>Deuda</th>
              <th>Neto</th>
            </tr>
          </thead>
          <tbody id="wealth-timeline-body"></tbody>
        </table>
      </div>
    </article>
  </div>

  <dialog id="wealth-calc-dialog" class="wealth-calc-dialog">
    <form id="wealth-calc-form" class="wealth-calc-form" method="dialog" autocomplete="off">
      <div class="wealth-calc-head">
        <h3 id="wealth-calc-title">Calcular snapshot</h3>
        <button id="wealth-calc-close" type="button" class="tx-close-btn" aria-label="Cerrar cálculo">✕</button>
      </div>
      <label>
        Cálculo numérico
        <input
          id="wealth-calc-expression"
          name="wealthCalcExpression"
          type="text"
          placeholder="Ej: 1200+35,5*2"
          autocomplete="off"
        />
      </label>
      <div class="wealth-calc-actions">
        <button id="wealth-calc-apply" type="submit" class="tx-btn-primary">Aplicar al snapshot</button>
      </div>
    </form>
  </dialog>
</section>
