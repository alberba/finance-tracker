---
export interface Props {
  isActive?: boolean
}

const { isActive = false } = Astro.props
---

<section
  id="budget"
  class:list={['panel', { 'is-active': isActive }]}
  aria-labelledby="budget-title"
>
  <div class="panel-head">
    <div>
      <p class="panel-kicker">Planificación anual</p>
      <h2 id="budget-title">Presupuesto</h2>
      <p>
        Revisa todo el año de una vez y edita el presupuesto mensual por
        categoría en tablas separadas.
      </p>
    </div>
  </div>

  <div class="cards-grid slim">
    <article class="kpi-card">
      <p>Presupuestado anual</p>
      <strong id="budget-total-planned">€0</strong>
    </article>
    <article class="kpi-card">
      <p>Real anual</p>
      <strong id="budget-total-actual">€0</strong>
    </article>
    <article class="kpi-card">
      <p>Diferencia anual</p>
      <strong id="budget-total-diff">€0</strong>
    </article>
  </div>

  <div id="budget-tables" class="budget-tables"></div>
</section>
