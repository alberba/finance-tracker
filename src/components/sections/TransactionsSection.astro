---
export interface Props {
  isActive?: boolean
}

const { isActive = false } = Astro.props
---

<section
  id="transactions"
  class:list={['panel', { 'is-active': isActive }]}
  aria-labelledby="transactions-title"
>
  <div class="panel-head">
    <div>
      <p class="panel-kicker">Registro mensual</p>
      <h2 id="transactions-title">Movimientos mensuales</h2>
      <p>Registro diario de ingresos, gastos e inversión por mes.</p>
    </div>
    <div class="inline-controls">
      <label>
        Filtrar mes
        <select id="tx-month-filter" name="txMonthFilter"></select>
      </label>
      <button id="tx-open-modal" type="button" class="primary-btn">Nuevo</button
      >
    </div>
  </div>

  <article class="card tx-bulk-card">
    <h3>Selección múltiple</h3>
    <div class="tx-bulk-grid">
      <p id="tx-selected-count" class="tx-selected-count">0 seleccionadas</p>
      <label>
        Tipo (lote)
        <select id="tx-bulk-type" name="txBulkType">
          <option value="">Sin cambio</option>
          <option value="income">Ingreso</option>
          <option value="expense">Gasto</option>
          <option value="investment">Inversión</option>
        </select>
      </label>
      <label>
        Cuenta (lote)
        <select id="tx-bulk-account" name="txBulkAccount">
          <option value="">Sin cambio</option>
        </select>
      </label>
      <label>
        Categoría (lote)
        <input
          id="tx-bulk-category"
          name="txBulkCategory"
          type="text"
          placeholder="Sin cambio"
          autocomplete="off"
        />
      </label>
      <button id="tx-bulk-apply" type="button" class="secondary-btn"
        >Aplicar</button
      >
      <button id="tx-bulk-delete" type="button" class="danger-btn"
        >Eliminar</button
      >
    </div>
  </article>

  <dialog id="tx-dialog" class="tx-dialog">
    <form
      id="tx-form"
      class="tx-form-dialog"
      method="dialog"
      autocomplete="off"
    >
      <div class="tx-dialog-head">
        <div class="tx-dialog-title">
          <span class="tx-dialog-icon" aria-hidden="true">+</span>
          <h3>Nuevo movimiento</h3>
        </div>
        <button
          id="tx-close-modal"
          type="button"
          class="tx-close-btn"
          aria-label="Cerrar">✕</button
        >
      </div>
      <div class="tx-form-fields">
        <label>
          Fecha
          <input type="date" name="date" required autocomplete="off" />
        </label>
        <label>
          Mes
          <select name="month" required></select>
        </label>
        <label>
          Tipo
          <select name="type" required id="tx-type-select">
            <option value="expense">Gasto</option>
            <option value="income">Ingreso</option>
            <option value="investment">Inversión</option>
          </select>
        </label>
        <label>
          Cuenta
          <select name="accountId" required></select>
        </label>
        <label class="tx-category-field">
          Categoría
          <select name="category" required></select>
        </label>
        <label class="span-3">
          Descripción
          <input
            type="text"
            name="description"
            maxlength="140"
            placeholder="Detalle opcional"
            autocomplete="off"
          />
        </label>
        <label class="tx-amount-field">
          Importe
          <div class="tx-amount-wrap">
            <span class="tx-amount-currency">€</span>
            <input
              type="number"
              name="amount"
              min="0"
              step="0.01"
              required
              placeholder="0.00"
              autocomplete="off"
            />
          </div>
        </label>
      </div>
      <div class="tx-dialog-actions">
        <button id="tx-submit-more" type="submit" class="tx-btn-secondary"
          >Otro</button
        >
        <button type="submit" class="tx-btn-primary">Guardar</button>
      </div>
    </form>
  </dialog>

  <div class="tx-layout">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="tx-col-select">
              <input
                id="tx-select-all"
                name="txSelectAll"
                type="checkbox"
                aria-label="Seleccionar todas las filas visibles"
              />
            </th>
            <th class="tx-head tx-head--filterable" data-filter-column="date">
              <div class="tx-head-main">
                <button
                  type="button"
                  class="tx-filter-trigger"
                  data-column="date"
                  aria-haspopup="true"
                  aria-expanded="false">Fecha</button
                >
                <button
                  type="button"
                  class="tx-sort-btn"
                  data-column="date"
                  aria-label="Ordenar por fecha">↕</button
                >
              </div>
              <div class="tx-filter-popover" data-column="date" hidden>
                <label for="tx-header-filter-date">Filtrar fecha</label>
                <input
                  id="tx-header-filter-date"
                  name="txHeaderFilterDate"
                  type="date"
                  autocomplete="off"
                />
                <button
                  type="button"
                  class="tx-header-clear-btn"
                  data-column="date">Limpiar</button
                >
              </div>
            </th>
            <th
              class="tx-head tx-head--filterable"
              data-filter-column="description"
            >
              <div class="tx-head-main">
                <button
                  type="button"
                  class="tx-filter-trigger"
                  data-column="description"
                  aria-haspopup="true"
                  aria-expanded="false">Descripción</button
                >
                <button
                  type="button"
                  class="tx-sort-btn"
                  data-column="description"
                  aria-label="Ordenar por descripción">↕</button
                >
              </div>
              <div class="tx-filter-popover" data-column="description" hidden>
                <label for="tx-header-filter-description">Descripción</label>
                <input
                  id="tx-header-filter-description"
                  name="txHeaderFilterDescription"
                  type="text"
                  placeholder="Contiene..."
                  autocomplete="off"
                />
                <button
                  type="button"
                  class="tx-header-clear-btn"
                  data-column="description">Limpiar</button
                >
              </div>
            </th>
            <th class="tx-head tx-head--filterable" data-filter-column="amount">
              <div class="tx-head-main">
                <button
                  type="button"
                  class="tx-filter-trigger"
                  data-column="amount"
                  aria-haspopup="true"
                  aria-expanded="false">Importe</button
                >
                <button
                  type="button"
                  class="tx-sort-btn"
                  data-column="amount"
                  aria-label="Ordenar por importe">↕</button
                >
              </div>
              <div class="tx-filter-popover" data-column="amount" hidden>
                <label for="tx-header-filter-amount-min">Importe mín</label>
                <input
                  id="tx-header-filter-amount-min"
                  name="txHeaderFilterAmountMin"
                  type="number"
                  min="0"
                  step="0.01"
                  autocomplete="off"
                />
                <label for="tx-header-filter-amount-max">Importe máx</label>
                <input
                  id="tx-header-filter-amount-max"
                  name="txHeaderFilterAmountMax"
                  type="number"
                  min="0"
                  step="0.01"
                  autocomplete="off"
                />
                <button
                  type="button"
                  class="tx-header-clear-btn"
                  data-column="amount">Limpiar</button
                >
              </div>
            </th>
            <th
              class="tx-head tx-head--filterable"
              data-filter-column="account"
            >
              <div class="tx-head-main">
                <button
                  type="button"
                  class="tx-filter-trigger"
                  data-column="account"
                  aria-haspopup="true"
                  aria-expanded="false">Cuenta</button
                >
                <button
                  type="button"
                  class="tx-sort-btn"
                  data-column="account"
                  aria-label="Ordenar por cuenta">↕</button
                >
              </div>
              <div class="tx-filter-popover" data-column="account" hidden>
                <label>Cuenta</label>
                <div
                  id="tx-header-filter-account"
                  class="tx-checkbox-list"
                  aria-label="Filtrar cuentas"
                >
                </div>
                <button
                  type="button"
                  class="tx-header-clear-btn"
                  data-column="account">Limpiar</button
                >
              </div>
            </th>
            <th class="tx-head tx-head--filterable" data-filter-column="type">
              <div class="tx-head-main">
                <button
                  type="button"
                  class="tx-filter-trigger"
                  data-column="type"
                  aria-haspopup="true"
                  aria-expanded="false">Tipo</button
                >
                <button
                  type="button"
                  class="tx-sort-btn"
                  data-column="type"
                  aria-label="Ordenar por tipo">↕</button
                >
              </div>
              <div class="tx-filter-popover" data-column="type" hidden>
                <label>Tipo</label>
                <div
                  id="tx-header-filter-type"
                  class="tx-checkbox-list"
                  aria-label="Filtrar tipos"
                >
                </div>
                <button
                  type="button"
                  class="tx-header-clear-btn"
                  data-column="type">Limpiar</button
                >
              </div>
            </th>
            <th
              class="tx-head tx-head--filterable"
              data-filter-column="category"
            >
              <div class="tx-head-main">
                <button
                  type="button"
                  class="tx-filter-trigger"
                  data-column="category"
                  aria-haspopup="true"
                  aria-expanded="false">Categoría</button
                >
                <button
                  type="button"
                  class="tx-sort-btn"
                  data-column="category"
                  aria-label="Ordenar por categoría">↕</button
                >
              </div>
              <div class="tx-filter-popover" data-column="category" hidden>
                <label for="tx-header-filter-category">Categoría</label>
                <input
                  id="tx-header-filter-category"
                  name="txHeaderFilterCategory"
                  type="text"
                  placeholder="Contiene..."
                  autocomplete="off"
                />
                <button
                  type="button"
                  class="tx-header-clear-btn"
                  data-column="category">Limpiar</button
                >
              </div>
            </th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="tx-table-body"></tbody>
      </table>
    </div>

    <aside class="tx-summary-side" aria-label="Resumen de movimientos">
      <article class="tx-summary-card">
        <table class="tx-summary-table tx-summary-table--totals">
          <thead>
            <tr>
              <th colspan="3" class="tx-summary-title">TOTAL</th>
            </tr>
            <tr>
              <th class="tx-summary-heading tx-summary-heading--income"
                >INGRESOS</th
              >
              <th class="tx-summary-heading tx-summary-heading--expense"
                >GASTOS</th
              >
              <th class="tx-summary-heading tx-summary-heading--investment"
                >INVERSIÓN</th
              >
            </tr>
          </thead>
          <tbody>
            <tr>
              <td id="tx-total-income" class="tx-summary-total-value">0 €</td>
              <td id="tx-total-expense" class="tx-summary-total-value">0 €</td>
              <td id="tx-total-investment" class="tx-summary-total-value"
                >0 €</td
              >
            </tr>
          </tbody>
        </table>
      </article>

      <article class="tx-summary-card">
        <table class="tx-summary-table tx-summary-table--breakdown">
          <thead>
            <tr>
              <th class="tx-summary-title">DESGLOSE POR CATEGORÍAS</th>
            </tr>
          </thead>
          <tbody id="tx-category-breakdown-body"></tbody>
        </table>
      </article>
    </aside>
  </div>
</section>
