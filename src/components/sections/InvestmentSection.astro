<section id="investment" class="panel" aria-labelledby="investment-title">
  <div class="panel-head">
    <div>
      <h2 id="investment-title">Inversión y aportes</h2>
      <p>Evolución de cartera, distribución y registro de aportaciones.</p>
    </div>
    <div class="inline-controls">
      <div class="return-mode-toggle" role="group" aria-label="Modo de cálculo de rentabilidad">
        <span class="return-mode-toggle__label">Rentabilidad</span>
        <button type="button" class="return-mode-btn is-active" data-return-mode="simple" aria-pressed="true">Simple</button>
        <button type="button" class="return-mode-btn" data-return-mode="twr" aria-pressed="false">TWR</button>
      </div>
      <label>
        Mes de análisis
        <select id="investment-month" name="investmentMonth"></select>
      </label>
    </div>
  </div>

  <div class="investment-subtabs" role="tablist" aria-label="Subsecciones de inversión">
    <button type="button" class="investment-subtab-btn is-active" data-investment-tab="dashboard" role="tab" aria-selected="true" aria-controls="investment-tab-dashboard">Dashboard</button>
    <button type="button" class="investment-subtab-btn" data-investment-tab="movements" role="tab" aria-selected="false" aria-controls="investment-tab-movements">Movimientos</button>
    <button type="button" class="investment-subtab-btn" data-investment-tab="contributions" role="tab" aria-selected="false" aria-controls="investment-tab-contributions">Aportes</button>
  </div>

  <div id="investment-tab-dashboard" class="investment-subtab-panel is-active" data-investment-tab-panel="dashboard" role="tabpanel">
    <div class="cards-grid slim">
      <article class="kpi-card">
        <p>Valor cartera</p>
        <strong id="inv-total-value">€0</strong>
      </article>
      <article class="kpi-card">
        <p>Capital invertido</p>
        <strong id="inv-capital">€0</strong>
      </article>
      <article class="kpi-card">
        <p id="inv-return-label">Rentabilidad estimada</p>
        <strong id="inv-return">0%</strong>
      </article>
    </div>

    <div class="chart-grid-inv">
      <article class="card">
        <h3>Evolución de la cartera</h3>
        <div class="chart-canvas-wrap"><canvas id="investment-portfolio-chart" aria-label="Evolución cartera total"></canvas></div>
      </article>
      <article class="card">
        <h3>Evolución por activo</h3>
        <div class="chart-canvas-wrap"><canvas id="investment-assets-chart" aria-label="Evolución por activo"></canvas></div>
      </article>
    </div>

    <div class="dual-grid">
      <article class="card">
        <h3>Distribución de activos</h3>
        <div class="chart-canvas-wrap"><canvas id="investment-allocation" aria-label="Distribución de cartera"></canvas></div>
      </article>
    </div>
  </div>

  <div id="investment-tab-movements" class="investment-subtab-panel" data-investment-tab-panel="movements" role="tabpanel" hidden>
    <article class="card">
      <h3>Nuevo movimiento de inversión</h3>
      <form id="investment-movement-form" class="form-grid investment-form" autocomplete="off">
        <label>
          Fecha
          <input id="investment-movement-date" name="date" type="date" required />
        </label>
        <label>
          Hora
          <input id="investment-movement-time" name="time" type="time" required />
        </label>
        <label>
          Operación
          <select id="investment-movement-side" name="side" required>
            <option value="buy">Compra</option>
            <option value="sell">Venta</option>
          </select>
        </label>
        <label>
          Símbolo
          <input id="investment-movement-symbol" name="symbol" type="text" maxlength="20" required placeholder="VWCE" />
        </label>
        <label>
          Categoría
          <select id="investment-movement-category" name="category"></select>
        </label>
        <label>
          Precio compra (€)
          <input id="investment-movement-unit-price" name="unitPrice" type="number" min="0" step="0.0001" required />
        </label>
        <label>
          Títulos
          <input id="investment-movement-units" name="units" type="number" min="0" step="0.00000001" required />
        </label>
        <label>
          Comisiones
          <input id="investment-movement-fee" name="fee" type="number" min="0" step="0.01" value="0" required />
        </label>
        <label>
          Gasto (incl. comisión)
          <input id="investment-movement-total" name="total" type="number" readonly />
        </label>
        <label>
          Moneda
          <input id="investment-movement-currency" name="movementCurrency" type="text" maxlength="3" value="EUR" required />
        </label>
        <label>
          Broker
          <select id="investment-movement-broker" name="accountId" required></select>
        </label>
        <label class="investment-declared-field">
          <input id="investment-movement-declared" name="declared" type="checkbox" />
          Declarado
        </label>
        <button type="submit" class="primary-btn">Guardar movimiento</button>
      </form>
    </article>

    <article class="card">
      <h3>Movimientos de inversión</h3>
      <div class="inline-controls investment-table-controls">
        <label>
          Año
          <select id="investment-year-filter" name="investmentYearFilter"></select>
        </label>
        <label class="investment-declared-field">
          <input id="investment-only-undeclared" name="investmentOnlyUndeclared" type="checkbox" />
          Solo no declarados
        </label>
      </div>
      <div class="table-wrap compact">
        <table>
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Hora</th>
              <th>Operación</th>
              <th>Símbolo</th>
              <th>Precio (€)</th>
              <th>Títulos</th>
              <th>Comisión</th>
              <th>Gasto total</th>
              <th>Moneda</th>
              <th>Broker</th>
              <th>Declarado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="investment-tx-table-body"></tbody>
        </table>
      </div>
    </article>
  </div>

  <div id="investment-tab-contributions" class="investment-subtab-panel" data-investment-tab-panel="contributions" role="tabpanel" hidden>
    <article class="card">
      <div class="contribution-head">
        <h3>Aportes y TWR</h3>
        <button id="open-contribution-workflow" type="button" class="primary-btn">Añadir aporte</button>
      </div>
      <div class="table-wrap compact">
        <table>
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Valor cartera (cierre)</th>
              <th>Flujo del día</th>
              <th>VLE</th>
              <th>Participaciones antes</th>
              <th>Participaciones después</th>
              <th>Retorno período</th>
              <th>Retorno acumulado</th>
            </tr>
          </thead>
          <tbody id="contribution-body"></tbody>
        </table>
      </div>
    </article>
  </div>

  <dialog id="contribution-workflow-dialog" class="contribution-workflow-dialog">
    <form id="contribution-workflow-form" class="contribution-workflow-form" method="dialog" autocomplete="off">
      <div class="contribution-workflow-head">
        <h3 id="contribution-workflow-title">Nuevo aporte guiado</h3>
        <button id="contribution-workflow-close" type="button" class="tx-close-btn" aria-label="Cerrar recorrido">✕</button>
      </div>

      <p class="contribution-workflow-intro">
        Antes de registrar el aporte, completa snapshots de inversión y liquidez. Después reparte el importe entre cuentas de liquidez.
      </p>

      <div class="contribution-workflow-date">
        <label>
          Mes del aporte
          <select id="contribution-workflow-month" name="contributionWorkflowMonth"></select>
        </label>
        <label>
          Fecha del aporte
          <input id="contribution-workflow-date" name="contributionWorkflowDate" type="date" required />
        </label>
      </div>

      <div id="contribution-workflow-step-snapshot" data-contribution-step="snapshot">
        <h4>Paso 1 · Snapshot previo</h4>
        <p>Actualiza el snapshot de inversiones y liquidez objetivo para el mes seleccionado.</p>
        <div id="contribution-workflow-snapshot-warning" class="workflow-warning" role="status" aria-live="polite"></div>

        <div class="table-wrap compact contribution-workflow-table">
          <table>
            <thead>
              <tr>
                <th>Activo</th>
                <th>Snapshot inversión</th>
              </tr>
            </thead>
            <tbody id="contribution-workflow-investments-body"></tbody>
          </table>
        </div>

        <div class="table-wrap compact contribution-workflow-table">
          <table>
            <thead>
              <tr>
                <th>Cuenta liquidez</th>
                <th>Snapshot liquidez</th>
              </tr>
            </thead>
            <tbody id="contribution-workflow-liquidity-body"></tbody>
          </table>
        </div>

      </div>

      <div id="contribution-workflow-step-allocation" data-contribution-step="allocation" hidden>
        <h4>Paso 2 · Reparto del aporte</h4>
        <p>Indica el importe total y reparte cuánto entra en cada cuenta de liquidez.</p>

        <label>
          Importe total del aporte
          <input id="contribution-workflow-total" name="contributionWorkflowTotal" type="number" min="0" step="0.01" value="0" />
        </label>

        <div class="table-wrap compact contribution-workflow-table">
          <table>
            <thead>
              <tr>
                <th>Cuenta liquidez</th>
                <th>Importe asignado</th>
              </tr>
            </thead>
            <tbody id="contribution-workflow-allocation-body"></tbody>
          </table>
        </div>

        <div id="contribution-workflow-allocation-warning" class="workflow-warning" role="status" aria-live="polite"></div>
      </div>

      <div class="contribution-workflow-actions">
        <button id="contribution-workflow-prev" type="button" class="tx-btn-secondary">Anterior</button>
        <button id="contribution-workflow-next" type="button" class="tx-btn-secondary">Siguiente</button>
        <button id="contribution-workflow-save" type="submit" class="tx-btn-primary">Guardar aporte (con avisos)</button>
      </div>
    </form>
  </dialog>

  <dialog id="contribution-calc-dialog" class="wealth-calc-dialog">
    <form id="contribution-calc-form" class="wealth-calc-form" method="dialog" autocomplete="off">
      <div class="wealth-calc-head">
        <h3 id="contribution-calc-title">Calcular snapshot</h3>
        <button id="contribution-calc-close" type="button" class="tx-close-btn" aria-label="Cerrar cálculo">✕</button>
      </div>
      <label>
        Cálculo numérico
        <input
          id="contribution-calc-expression"
          name="contributionCalcExpression"
          type="text"
          placeholder="Ej: 1200+35,5*2"
          autocomplete="off"
        />
      </label>
      <div class="wealth-calc-actions">
        <button id="contribution-calc-apply" type="submit" class="tx-btn-primary">Aplicar al snapshot</button>
      </div>
    </form>
  </dialog>
</section>
