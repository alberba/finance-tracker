<section id="goals" class="panel" aria-labelledby="goals-title">
  <div class="panel-head">
    <div>
      <h2 id="goals-title">Objetivos</h2>
      <p>Seguimiento de metas patrimoniales y de inversión.</p>
    </div>
  </div>

  <div class="goal-edit-grid">
    <article class="card">
      <h3>Corto plazo</h3>
      <label>Nombre <input type="text" name="goalShortName" data-goal="short" data-field="name" autocomplete="off" /></label>
      <label>Año objetivo <input type="number" name="goalShortYear" data-goal="short" data-field="targetYear" min="2000" max="2100" autocomplete="off" /></label>
      <label>Monto objetivo <input type="number" name="goalShortAmount" data-goal="short" data-field="targetAmount" min="0" step="0.01" autocomplete="off" /></label>
    </article>
    <article class="card">
      <h3>Medio plazo</h3>
      <label>Nombre <input type="text" name="goalMediumName" data-goal="medium" data-field="name" autocomplete="off" /></label>
      <label>Año objetivo <input type="number" name="goalMediumYear" data-goal="medium" data-field="targetYear" min="2000" max="2100" autocomplete="off" /></label>
      <label>Monto objetivo <input type="number" name="goalMediumAmount" data-goal="medium" data-field="targetAmount" min="0" step="0.01" autocomplete="off" /></label>
    </article>
    <article class="card">
      <h3>Largo plazo</h3>
      <label>Nombre <input type="text" name="goalLongName" data-goal="long" data-field="name" autocomplete="off" /></label>
      <label>Año objetivo <input type="number" name="goalLongYear" data-goal="long" data-field="targetYear" min="2000" max="2100" autocomplete="off" /></label>
      <label>Monto objetivo <input type="number" name="goalLongAmount" data-goal="long" data-field="targetAmount" min="0" step="0.01" autocomplete="off" /></label>
    </article>
    <article class="card">
      <h3>Inversión total</h3>
      <label>Nombre <input type="text" name="goalInvestmentTotalName" data-goal="investmentTotal" data-field="name" autocomplete="off" /></label>
      <label>Año objetivo <input type="number" name="goalInvestmentTotalYear" data-goal="investmentTotal" data-field="targetYear" min="2000" max="2100" autocomplete="off" /></label>
      <label>Monto objetivo <input type="number" name="goalInvestmentTotalAmount" data-goal="investmentTotal" data-field="targetAmount" min="0" step="0.01" autocomplete="off" /></label>
    </article>
    <article class="card">
      <h3>Fondos indexados</h3>
      <label>Nombre <input type="text" name="goalInvestmentFundsName" data-goal="investmentFunds" data-field="name" autocomplete="off" /></label>
      <label>Año objetivo <input type="number" name="goalInvestmentFundsYear" data-goal="investmentFunds" data-field="targetYear" min="2000" max="2100" autocomplete="off" /></label>
      <label>Monto objetivo <input type="number" name="goalInvestmentFundsAmount" data-goal="investmentFunds" data-field="targetAmount" min="0" step="0.01" autocomplete="off" /></label>
    </article>
    <article class="card">
      <h3>Criptomonedas</h3>
      <label>Nombre <input type="text" name="goalInvestmentCryptoName" data-goal="investmentCrypto" data-field="name" autocomplete="off" /></label>
      <label>Año objetivo <input type="number" name="goalInvestmentCryptoYear" data-goal="investmentCrypto" data-field="targetYear" min="2000" max="2100" autocomplete="off" /></label>
      <label>Monto objetivo <input type="number" name="goalInvestmentCryptoAmount" data-goal="investmentCrypto" data-field="targetAmount" min="0" step="0.01" autocomplete="off" /></label>
    </article>
  </div>

  <div id="goals-progress" class="goal-progress"></div>
</section>
