---
import FinanceTrackerShell from "../components/FinanceTrackerShell.astro";

export function getStaticPaths() {
  return [
    { params: { section: "dashboard" } },
    { params: { section: "movimientos" } },
    { params: { section: "presupuesto" } },
    { params: { section: "patrimonio" } },
    { params: { section: "inversion" } },
    { params: { section: "objetivos" } },
    { params: { section: "configuracion" } },
    { params: { section: "datos" } },
    { params: { section: "reportes" } },
  ];
}

const sectionParam = String(Astro.params.section || "");
---

<FinanceTrackerShell activeRoute="section" sectionParam={sectionParam} />
