---
import AccessForm from '../components/auth/AccessForm.vue'
import '../styles/global.css'
import { getRuntimeEnv } from '../lib/server/cloudflare-env'
import { getDb } from '../db/client'
import { createAuthentication } from '../lib/server/auth/better-auth'
import { registrationInvitation } from '../db/repositories/authentication'
const env = getRuntimeEnv(Astro.locals)
const invitation = Astro.url.searchParams.get('invitation')
let invitationError = ''
let verifyEmail: string | undefined
if (env.AUTH_MODE === 'better-auth') {
  try {
    const session = await createAuthentication(getDb(Astro.locals), env).api.getSession({
      headers: Astro.request.headers,
      query: { disableCookieCache: true },
    })
    if (session && !session.user.emailVerified) verifyEmail = session.user.email
  } catch {
    /* The form remains usable while configuration is being prepared. */
  }
}
const initialError = Astro.url.searchParams.has('error')
  ? 'No se pudo completar el acceso con ese proveedor. Inténtalo de nuevo o entra con un código por correo para vincularlo desde ajustes.'
  : undefined
if (invitation) {
  try {
    await registrationInvitation(getDb(Astro.locals), invitation)
    Astro.cookies.set('finance-invitation', invitation, {
      httpOnly: true,
      sameSite: 'lax',
      secure: Astro.url.protocol === 'https:',
      path: '/',
      maxAge: 86400,
    })
  } catch (error) {
    invitationError = error instanceof Error ? error.message : 'Invitación no válida.'
    Astro.cookies.delete('finance-invitation', { path: '/' })
  }
}
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eef1f6" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Acceso · Finanzas</title>
  </head>
  <body>
    <main class="mx-auto flex min-h-svh w-full max-w-lg flex-col justify-center gap-6 px-5 py-8">
      <header class="text-center">
        <a
          href="/login"
          class="font-display inline-flex min-h-11 items-center text-2xl font-bold tracking-tight focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-2 active:opacity-70"
        >
          finanzas<span class="text-primary">.</span>
        </a>
      </header>
      <section
        class="border-line bg-panel grid min-h-access-card content-center has-[[data-access-mode=verify]]:min-h-0 rounded-xl border p-access-panel shadow-soft"
        aria-labelledby="access-heading"
      >
        <AccessForm
          client:load
          verifyEmail={verifyEmail}
          initialError={initialError}
          invitationError={invitationError}
          googleEnabled={Boolean(env.GOOGLE_CLIENT_ID)}
          githubEnabled={Boolean(env.GITHUB_CLIENT_ID)}
        />
      </section>
      <footer class="text-center">
        <a
          href="/?demo=true"
          class="text-text-muted inline-flex min-h-11 items-center text-sm underline underline-offset-4 focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-2 active:opacity-70"
        >
          Explorar la demo ↗
        </a>
      </footer>
    </main>
  </body>
</html>
