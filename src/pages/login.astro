---
import AccessForm from '../components/auth/AccessForm.vue'
import '../styles/global.css'
import { getRuntimeEnv } from '../lib/server/cloudflare-env'
import { getDb } from '../db/client'
import { createAuthentication } from '../lib/server/auth/better-auth'
import { registrationInvitation } from '../db/repositories/authentication'
const env = getRuntimeEnv(Astro.locals)
const invitation = Astro.url.searchParams.get('invitation')
let invitationError = ''
let verifyEmail: string | undefined
if (env.AUTH_MODE === 'better-auth') {
  try {
    const session = await createAuthentication(getDb(Astro.locals), env).api.getSession({
      headers: Astro.request.headers,
      query: { disableCookieCache: true },
    })
    if (session && !session.user.emailVerified) verifyEmail = session.user.email
  } catch {
    /* The form remains usable while configuration is being prepared. */
  }
}
const initialError = Astro.url.searchParams.has('error')
  ? 'No se pudo completar el acceso con ese proveedor. Inténtalo de nuevo o entra con un código por correo para vincularlo desde ajustes.'
  : undefined
if (invitation) {
  try {
    await registrationInvitation(getDb(Astro.locals), invitation)
    Astro.cookies.set('finance-invitation', invitation, {
      httpOnly: true,
      sameSite: 'lax',
      secure: Astro.url.protocol === 'https:',
      path: '/',
      maxAge: 86400,
    })
  } catch (error) {
    invitationError = error instanceof Error ? error.message : 'Invitación no válida.'
    Astro.cookies.delete('finance-invitation', { path: '/' })
  }
}
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf8f4" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>Acceso · Finanzas</title>
  </head>
  <body>
    <main class="mx-auto grid min-h-dvh max-w-6xl grid-cols-1 items-center gap-8 px-5 py-8 md:grid-cols-2 md:gap-20 md:px-8">
      <aside>
        <p class="text-text-muted font-mono text-sm uppercase">Finanzas personales</p>
        <h1 class="font-display my-4 text-5xl leading-tight font-normal tracking-tight sm:text-6xl lg:text-7xl">
          Tu dinero.
          <br />
          Tu espacio.
        </h1>
        <p class="text-text-muted">Presupuesto, inversiones y objetivos, en un mismo lugar.</p>
        <a class="mt-6 inline-block text-primary underline underline-offset-4" href="/?demo=true">
          Explorar la demo
        </a>
      </aside>
      <section
        class="border-line border-t pt-8 md:border-t-0 md:border-l md:pt-0 md:pl-12"
        aria-labelledby="access-heading"
      >
        <p class="text-text-muted mb-3 font-mono text-sm uppercase">Bienvenido</p>
        <h2 id="access-heading" class="mb-3 font-display text-2xl">
          Accede a Finanzas
        </h2>
        <p class="mb-8">
          Elige cómo quieres entrar. Si ya usabas Finanzas, entra con un código enviado a tu correo
          habitual.
        </p>
        <AccessForm
          client:load
          verifyEmail={verifyEmail}
          initialError={initialError}
          invitationError={invitationError}
          googleEnabled={Boolean(env.GOOGLE_CLIENT_ID)}
          githubEnabled={Boolean(env.GITHUB_CLIENT_ID)}
        />
      </section>
    </main>
  </body>
</html>
