# Copia este archivo como .dev.vars y sustituye los valores por tus claves.
# Nunca subas .dev.vars al repositorio.
MARKET_DATA_PROVIDER=yahoo
MARKET_QUOTE_STALE_MINUTES=15
MARKET_QUOTE_CACHE_SECONDS=300

# Yahoo Finance no necesita clave. Twelve Data es una alternativa opcional.
TWELVE_DATA_API_KEY=

# Opcional: respaldo específico para cripto.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo

# Solo para desarrollo local / Playwright (WP8): habilita la cabecera
# `X-Test-User-Email` como atajo de autenticación sin sesión Better Auth
# (ver src/middleware.ts). NUNCA definir esta variable en wrangler.toml
# [vars] ni en ningún entorno desplegado — solo aquí y en CI efímero.
TEST_AUTH_ENABLED=true

# GitHub: alta de reportes y seguimiento en «Mis reportes».
GITHUB_ISSUE_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Opcional: login del bot cuando el token es de una GitHub App (no puede leer /user).
GITHUB_BOT_LOGIN=

# Autenticación integrada (#275).
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=
RESEND_API_KEY=
RESEND_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Procedimiento: docs/operations/authentication.md
