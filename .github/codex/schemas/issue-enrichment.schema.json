{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-tracker.invalid/schemas/issue-enrichment.schema.json",
  "title": "Finance Tracker issue enrichment",
  "description": "Structured output expected from Codex when enriching a web report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "body_markdown",
    "labels_add",
    "labels_keep",
    "labels_remove"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body_markdown": {
      "type": "string",
      "minLength": 1
    },
    "labels_add": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "labels_keep": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "labels_remove": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
