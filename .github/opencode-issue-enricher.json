{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "enabled_providers": ["opencode-go"],
  "providers": {
    "opencode-go": {
      "settings": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    }
  },
  "update": "disable",
  "share": "disabled",
  "snapshots": false,
  "agents": {
    "build": {
      "permissions": [{ "action": "question", "resource": "*", "effect": "deny" }]
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "/proc/*", "effect": "deny" },
    { "action": "read", "resource": "/home/runner/*", "effect": "deny" },
    { "action": "read", "resource": "/etc/*", "effect": "deny" },
    { "action": "read", "resource": "/dev/*", "effect": "deny" },
    { "action": "read", "resource": "/sys/*", "effect": "deny" },
    { "action": "read", "resource": "/root/*", "effect": "deny" },
    { "action": "read", "resource": "/tmp/*", "effect": "deny" },
    { "action": "read", "resource": "{env:GITHUB_WORKSPACE}*", "effect": "allow" },
    { "action": "read", "resource": "{env:GITHUB_WORKSPACE}/.git*", "effect": "deny" },
    { "action": "read", "resource": "{env:GITHUB_WORKSPACE}/*.env*", "effect": "deny" },
    { "action": "read", "resource": "{env:GITHUB_WORKSPACE}/.dev.vars*", "effect": "deny" },
    { "action": "read", "resource": "AGENTS.md", "effect": "allow" },
    { "action": "read", "resource": "CODING_STANDARDS.md", "effect": "allow" },
    { "action": "read", "resource": "CONTRIBUTING.md", "effect": "allow" },
    { "action": "read", "resource": "GLOSSARY.md", "effect": "allow" },
    { "action": "read", "resource": "README.md", "effect": "allow" },
    { "action": "read", "resource": "package.json", "effect": "allow" },
    { "action": "read", "resource": "astro.config.ts", "effect": "allow" },
    { "action": "read", "resource": "drizzle.config.ts", "effect": "allow" },
    { "action": "read", "resource": "eslint.config.ts", "effect": "allow" },
    { "action": "read", "resource": "tsconfig.json", "effect": "allow" },
    { "action": "read", "resource": "vitest.config.ts", "effect": "allow" },
    { "action": "read", "resource": "wrangler.toml", "effect": "allow" },
    { "action": "read", "resource": ".agents*", "effect": "allow" },
    { "action": "read", "resource": ".github*", "effect": "allow" },
    { "action": "read", "resource": ".scratch*", "effect": "allow" },
    { "action": "read", "resource": "docs*", "effect": "allow" },
    { "action": "read", "resource": "migrations-v2*", "effect": "allow" },
    { "action": "read", "resource": "scripts*", "effect": "allow" },
    { "action": "read", "resource": "src*", "effect": "allow" },
    { "action": "read", "resource": "tests*", "effect": "allow" },
    { "action": "read", "resource": ".git*", "effect": "deny" },
    { "action": "read", "resource": "*.env*", "effect": "deny" },
    { "action": "read", "resource": "*.dev.vars*", "effect": "deny" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "create-issue", "effect": "allow" },
    { "action": "edit", "resource": ".scratch*", "effect": "allow" },
    { "action": "edit", "resource": "{env:GITHUB_WORKSPACE}/.scratch*", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view {env:ISSUE_NUMBER} *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue comment {env:ISSUE_NUMBER} *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue edit {env:ISSUE_NUMBER} *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh label list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue comment --help", "effect": "allow" },
    { "action": "shell", "resource": "mktemp *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "gh issue comment {env:ISSUE_NUMBER} *--body-file*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh issue comment {env:ISSUE_NUMBER} --body-file /tmp/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue comment {env:ISSUE_NUMBER} --body-file .scratch/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue edit {env:ISSUE_NUMBER} *--body-file*",
      "effect": "deny"
    },
    { "action": "shell", "resource": "gh issue create *", "effect": "deny" },
    { "action": "shell", "resource": "gh issue create --help", "effect": "allow" },
    { "action": "shell", "resource": "*/proc/*", "effect": "deny" },
    { "action": "shell", "resource": "*/home/runner/*", "effect": "deny" },
    { "action": "shell", "resource": "*/etc/*", "effect": "deny" },
    { "action": "shell", "resource": "*GH_TOKEN*", "effect": "deny" },
    { "action": "shell", "resource": "*OPENCODE_GO_API_KEY*", "effect": "deny" },
    { "action": "shell", "resource": "*GITHUB_TOKEN*", "effect": "deny" }
  ]
}
