{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "enabled_providers": ["opencode-go"],
  "providers": {
    "opencode-go": {
      "settings": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    }
  },
  "update": "disable",
  "share": "disabled",
  "snapshots": false,
  "agents": {
    "build": {
      "permissions": [{ "action": "question", "resource": "*", "effect": "deny" }]
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "/*", "effect": "deny" },
    { "action": "read", "resource": "~*", "effect": "deny" },
    { "action": "read", "resource": "{env:GITHUB_WORKSPACE}*", "effect": "allow" },
    { "action": "read", "resource": "{env:GITHUB_WORKSPACE}/.git", "effect": "deny" },
    { "action": "read", "resource": "{env:GITHUB_WORKSPACE}/.git/*", "effect": "deny" },
    { "action": "read", "resource": "*..*", "effect": "deny" },
    { "action": "read", "resource": ".git", "effect": "deny" },
    { "action": "read", "resource": ".git/*", "effect": "deny" },
    { "action": "read", "resource": "*.env*", "effect": "deny" },
    { "action": "read", "resource": "*.dev.vars*", "effect": "deny" },

    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "/*", "effect": "deny" },
    { "action": "glob", "resource": "~*", "effect": "deny" },
    { "action": "glob", "resource": "*..*", "effect": "deny" },

    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "/*", "effect": "deny" },
    { "action": "grep", "resource": "~*", "effect": "deny" },
    { "action": "grep", "resource": "*..*", "effect": "deny" },

    { "action": "skill", "resource": "create-issue", "effect": "allow" },

    { "action": "edit", "resource": ".scratch/enricher/*", "effect": "allow" },
    {
      "action": "edit",
      "resource": "{env:GITHUB_WORKSPACE}/.scratch/enricher/*",
      "effect": "allow"
    },
    { "action": "edit", "resource": "*..*", "effect": "deny" },

    { "action": "shell", "resource": "*", "effect": "deny" }
  ]
}
